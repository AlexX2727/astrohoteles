</style>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const mainImages = document.querySelectorAll(".main-image");
    const thumbnails = document.querySelectorAll(".thumbnail");
    const prevBtn = document.getElementById("prevBtn");
    const nextBtn = document.getElementById("nextBtn");
    const thumbnailsScroll = document.getElementById("thumbnailsScroll");
    let currentIndex = 0;
    let autoplayInterval: ReturnType<typeof setInterval> | null = null;
    const loadedImages = new Set<number>([0]); // Primera imagen ya cargada

    // Función para cargar imagen bajo demanda
    function loadImage(index: number) {
      if (loadedImages.has(index)) return;

      const imgElement = mainImages[index] as HTMLImageElement;
      const dataSrc = imgElement.getAttribute("data-src");

      if (dataSrc && !imgElement.src) {
        imgElement.src = dataSrc;
        loadedImages.add(index);
      }
    }

    // Pre-cargar imágenes cercanas
    function preloadNearbyImages(index: number) {
      // Cargar imagen actual y las 2 siguientes
      for (let i = 0; i <= 2; i++) {
        const nextIndex = (index + i) % mainImages.length;
        loadImage(nextIndex);
      }
    }

    function showImage(index: number, scroll: boolean = true) {
      // Cargar imagen antes de mostrarla
      loadImage(index);
      preloadNearbyImages(index);

      mainImages.forEach((img) => img.classList.remove("active"));
      thumbnails.forEach((thumb) => thumb.classList.remove("active"));

      mainImages[index].classList.add("active");
      thumbnails[index].classList.add("active");

      // Scroll thumbnail into view without scrolling the page
      if (scroll) {
        const thumbnail = thumbnails[index] as HTMLElement;
        const container = thumbnailsScroll;
        if (container && thumbnail) {
          const containerRect = container.getBoundingClientRect();
          const thumbnailRect = thumbnail.getBoundingClientRect();
          const scrollLeft =
            thumbnail.offsetLeft -
            container.offsetLeft -
            containerRect.width / 2 +
            thumbnailRect.width / 2;
          container.scrollTo({ left: scrollLeft, behavior: "smooth" });
        }
      }
    }

    function nextImage() {
      currentIndex = (currentIndex + 1) % mainImages.length;
      showImage(currentIndex, false); // No scroll durante autoplay
    }

    function startAutoplay() {
      // Primero limpiamos cualquier intervalo existente
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
      }
      // Luego creamos uno nuevo
      autoplayInterval = setInterval(nextImage, 6000);
    }

    function stopAutoplay() {
      if (autoplayInterval) {
        clearInterval(autoplayInterval);
        autoplayInterval = null;
      }
    }

    thumbnails.forEach((thumb, index) => {
      thumb.addEventListener("click", () => {
        currentIndex = index;
        showImage(currentIndex, true);
        stopAutoplay();
        startAutoplay();
      });
    });

    // Click en imagen principal para ver fullscreen
    const imageModal = document.getElementById("imageModal");
    const modalImage = document.getElementById(
      "modalImage",
    ) as HTMLImageElement;
    const closeModal = document.getElementById("closeModal");
    const modalPrevBtn = document.getElementById("modalPrevBtn");
    const modalNextBtn = document.getElementById("modalNextBtn");
    let modalCurrentIndex = 0;

    function showModalImage(index: number) {
      modalCurrentIndex = index;
      const imgElement = mainImages[index] as HTMLImageElement;
      const imgSrc = imgElement.src || imgElement.getAttribute("data-src");
      if (imgSrc && modalImage) {
        modalImage.src = imgSrc;
      }
    }

    mainImages.forEach((img, index) => {
      img.addEventListener("click", () => {
        if (modalImage && imageModal) {
          showModalImage(index);
          imageModal.classList.add("active");
          document.body.style.overflow = "hidden";
          stopAutoplay();
        }
      });
    });

    // Navegación en modal
    if (modalPrevBtn) {
      modalPrevBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        modalCurrentIndex =
          (modalCurrentIndex - 1 + mainImages.length) % mainImages.length;
        showModalImage(modalCurrentIndex);
      });
    }

    if (modalNextBtn) {
      modalNextBtn.addEventListener("click", (e) => {
        e.stopPropagation();
        modalCurrentIndex = (modalCurrentIndex + 1) % mainImages.length;
        showModalImage(modalCurrentIndex);
      });
    }

    if (closeModal && imageModal) {
      closeModal.addEventListener("click", (e) => {
        e.stopPropagation();
        imageModal.classList.remove("active");
        document.body.style.overflow = "auto";
        startAutoplay();
      });

      imageModal.addEventListener("click", () => {
        imageModal.classList.remove("active");
        document.body.style.overflow = "auto";
        startAutoplay();
      });
    }

    // Cerrar con tecla ESC y navegar con flechas
    document.addEventListener("keydown", (e) => {
      if (imageModal?.classList.contains("active")) {
        if (e.key === "Escape") {
          imageModal.classList.remove("active");
          document.body.style.overflow = "auto";
          startAutoplay();
        } else if (e.key === "ArrowLeft") {
          modalCurrentIndex =
            (modalCurrentIndex - 1 + mainImages.length) % mainImages.length;
          showModalImage(modalCurrentIndex);
        } else if (e.key === "ArrowRight") {
          modalCurrentIndex = (modalCurrentIndex + 1) % mainImages.length;
          showModalImage(modalCurrentIndex);
        }
      }
    });

    prevBtn?.addEventListener("click", () => {
      currentIndex = (currentIndex - 1 + mainImages.length) % mainImages.length;
      showImage(currentIndex, true);
      stopAutoplay();
      startAutoplay();
    });

    nextBtn?.addEventListener("click", () => {
      currentIndex = (currentIndex + 1) % mainImages.length;
      showImage(currentIndex, true);
      stopAutoplay();
      startAutoplay();
    });

    // Pre-cargar las primeras 3 imágenes al inicio
    preloadNearbyImages(0);

    // Start autoplay on load
    startAutoplay();

    // Pause autoplay on hover
    const mainImageContainer = document.querySelector(".main-image-container");
    if (mainImageContainer) {
      mainImageContainer.addEventListener("mouseenter", stopAutoplay);
      mainImageContainer.addEventListener("mouseleave", startAutoplay);
    }

    // Limpiar intervalo cuando se cierra/recarga la página
    window.addEventListener("beforeunload", () => {
      stopAutoplay();
    });

    // Ajustar object-fit según orientación de imagen
    mainImages.forEach((img) => {
      const imgElement = img as HTMLImageElement;
      imgElement.addEventListener("load", function () {
        if (this.naturalWidth > this.naturalHeight) {
          // Imagen horizontal - usar cover
          this.style.objectFit = "cover";
        } else {
          // Imagen vertical - usar contain
          this.style.objectFit = "contain";
        }
      });
      // Verificar si ya está cargada
      if (imgElement.complete) {
        if (imgElement.naturalWidth > imgElement.naturalHeight) {
          imgElement.style.objectFit = "cover";
        } else {
          imgElement.style.objectFit = "contain";
        }
      }
    });
  });
</script>
