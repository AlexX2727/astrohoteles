---
import Layout from '../layouts/Layout.astro';
import { getAmenityIcon } from '../data/accommodationData.js';

const images = [
  "/images/departamentos/Villa del mar/1D/Puerta.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2364.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2365.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2369.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2370.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2373.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2374.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2375.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2378.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2381.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2384.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2388.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2390.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2397.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2402.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2405.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2407.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2411.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2414.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2415.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2416.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2417.jpg",
  "/images/departamentos/Villa del mar/1D/IMG_2419.jpg"
];

const amenities = [
  { icon: "👥", name: "Capacidad de huéspedes" },
  { icon: "📶", name: "WiFi gratuito" },
  { icon: "🍳", name: "Cocina equipada" },
  { icon: "🛁", name: "Baño privado" }
];

const features = [
  "Dormitorio con cama matrimonial",
  "Cocina completamente equipada",
  "Baño privado completo",
  "Televisión",
  "WiFi de alta velocidad",
  "Utensilios de cocina",
  "Ropa de cama y toallas incluidas"
];

const policies = [
  "Check-in: 14:00 hrs",
  "Check-out: 12:00 hrs",
  "No se permiten mascotas",
  "No fumar dentro del departamento",
  "Mantener el orden y limpieza",
  "Respetar el horario de silencio (22:00 - 08:00 hrs)"
];
---

<Layout title="Departamento 1D - Hotel Villa del Mar">
  <div class="hotel-detail">
    <!-- Header con título -->
    <div class="hero-header">
      <h1 class="hotel-title">Departamento 1D</h1>
      <p class="hotel-subtitle">Hotel Villa del Mar - Salinas, Ecuador</p>
    </div>

    <!-- Hero Section with Image Gallery -->
    <section class="hero-gallery">
      <div class="gallery-main-area">
        <div class="main-image-container">
          <img src={images[0]} alt="Departamento 1D" class="main-image active" id="mainImage" />
          {images.slice(1).map((img) => (
            <img src={img} alt="Departamento 1D" class="main-image" />
          ))}
        </div>

        <div class="thumbnails-container">
          <button class="thumbnail-nav prev" id="prevBtn">‹</button>
          <div class="thumbnails-scroll" id="thumbnailsScroll">
            {images.map((img, index) => (
              <img
                src={img}
                alt={`Vista ${index + 1}`}
                class={`thumbnail ${index === 0 ? 'active' : ''}`}
                data-index={index}
              />
            ))}
          </div>
          <button class="thumbnail-nav next" id="nextBtn">›</button>
        </div>
      </div>

      <!-- Sidebar de reserva sticky en hero -->
      <div class="hero-sidebar">
        <div class="booking-card">
          <a
            href="https://wa.me/593996779325?text=Hola, estoy interesado en reservar el Departamento 1D"
            target="_blank"
            rel="noopener"
            class="reserve-button"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Reservar
          </a>

          <div class="contact-info">
            <p class="info-title">¿Tienes preguntas?</p>
            <a href="mailto:reservas@hospedajesalinas.com" class="contact-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              reservas@hospedajesalinas.com
            </a>
            <a href="tel:+593996779325" class="contact-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              +593 99 677 9325
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Image Modal for Fullscreen -->
    <div class="image-modal" id="imageModal">
      <button class="image-modal-close" id="closeModal">×</button>
      <img src="" alt="Vista ampliada" id="modalImage" />
    </div>

    <!-- Hotel Info -->
    <section class="hotel-info">
      <div class="info-container">
        <div class="main-content">
        <!-- Amenities -->
        <div class="amenities-section">
          <h2>Comodidades</h2>
          <div class="amenities-grid">
            {amenities.map((amenity) => (
              <div class="amenity-item">
                <span class="amenity-icon" set:html={getAmenityIcon(amenity.icon)} />
                <span class="amenity-name">{amenity.name}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Features -->
        <div class="features-section">
          <h2>Características Destacadas</h2>
          <div class="features-grid">
            {features.map((feature) => (
              <div class="feature-item">
                <svg class="check-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                </svg>
                <span>{feature}</span>
              </div>
            ))}
          </div>
        </div>

        <!-- Spaces -->
        <div class="spaces-section">
          <h2>Espacios del Departamento</h2>
          <div class="spaces-grid">
            <div class="space-card">
              <div class="space-icon">🛏️</div>
              <h3>Dormitorio</h3>
              <p>1 cama matrimonial</p>
            </div>
            <div class="space-card">
              <div class="space-icon">🛁</div>
              <h3>Baño</h3>
              <p>Baño completo privado</p>
            </div>
            <div class="space-card">
              <div class="space-icon">📺</div>
              <h3>Sala</h3>
              <p>TV y área de estar</p>
            </div>
            <div class="space-card">
              <div class="space-icon">🍳</div>
              <h3>Cocina</h3>
              <p>Completamente equipada</p>
            </div>
          </div>
        </div>

        <!-- Policies -->
        <div class="policies-section">
          <h2>Políticas del Departamento</h2>
          <div class="policies-list">
            {policies.map((policy) => (
              <div class="policy-item">
                <svg class="info-icon" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
                </svg>
                <span>{policy}</span>
              </div>
            ))}
          </div>
        </div>
        </div>

        <!-- Sidebar de reserva -->
        <div class="sidebar-booking">
          <div class="booking-card">
            <a
              href="https://wa.me/593996779325?text=Hola, estoy interesado en reservar el Departamento 1D"
              target="_blank"
              rel="noopener"
              class="reserve-button"
            >
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
              Reservar
            </a>

            <div class="contact-info">
              <p class="info-title">¿Tienes preguntas?</p>
              <a href="mailto:reservas@hospedajesalinas.com" class="contact-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                  <polyline points="22,6 12,13 2,6"></polyline>
                </svg>
                reservas@hospedajesalinas.com
              </a>
              <a href="tel:+593996779325" class="contact-link">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
                </svg>
                +593 99 677 9325
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .hotel-detail {
    min-height: 100vh;
    background: #000;
    color: #fff;
    padding-top: 80px;
  }

  /* Header */
  .hero-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
  }

  .hotel-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(135deg, #0EA5E9, #22D3EE, #FFFFFF);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
    font-weight: 900;
  }

  .hotel-subtitle {
    font-size: 1.2rem;
    color: #b0b0b0;
    margin-bottom: 2rem;
  }

  /* Hero Gallery */
  .hero-gallery {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem 2rem 2rem;
    display: grid;
    grid-template-columns: 600px 1fr;
    gap: 3rem;
    align-items: start;
  }

  .gallery-main-area {
    width: 100%;
    max-width: 600px;
  }

  .main-image-container {
    position: relative;
    width: 100%;
    max-width: 600px;
    height: 400px;
    border-radius: 16px;
    overflow: hidden;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%);
    margin-bottom: 1rem;
    box-shadow: inset 0 0 100px rgba(0,0,0,0.5);
  }

  .main-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity 0.8s ease;
    cursor: zoom-in;
    pointer-events: none;
  }

  .main-image.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Image fullscreen modal */
  .image-modal {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.95);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 3000;
    cursor: zoom-out;
    padding: 2rem;
  }

  .image-modal.active {
    display: flex;
  }

  .image-modal img {
    max-width: 95%;
    max-height: 95%;
    object-fit: contain;
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0,0,0,0.8);
  }

  .image-modal-close {
    position: fixed;
    top: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid #fff;
    color: #fff;
    font-size: 2rem;
    border-radius: 50%;
    cursor: pointer;
    z-index: 3001;
    transition: all 0.3s;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-modal-close:hover {
    background: #FF6B35;
    transform: rotate(90deg);
  }

  .thumbnails-container {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 600px;
    width: 100%;
  }

  .thumbnail-nav {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: white;
    width: 35px;
    height: 35px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .thumbnail-nav:hover {
    background: rgba(255, 255, 255, 0.2);
    transform: scale(1.1);
  }

  .thumbnails-scroll {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding: 0.3rem 0;
    flex: 1;
  }

  .thumbnails-scroll::-webkit-scrollbar {
    display: none;
  }

  .thumbnail {
    width: 85px;
    height: 55px;
    object-fit: cover;
    border-radius: 6px;
    cursor: pointer;
    border: 2px solid transparent;
    transition: all 0.3s ease;
    flex-shrink: 0;
  }

  .thumbnail:hover {
    transform: scale(1.05);
    border-color: #0EA5E9;
  }

  .thumbnail.active {
    border-color: #FF6B35;
    transform: scale(1.05);
  }

  /* Hotel Info */
  .hotel-info {
    background: linear-gradient(to bottom, #000, #0a0a0a);
    padding: 3rem 1rem;
  }

  .info-container {
    max-width: 1400px;
    margin: 0 auto;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    max-width: 900px;
  }

  /* Sections */
  .amenities-section,
  .features-section,
  .spaces-section,
  .policies-section {
    margin-bottom: 3rem;
  }

  .amenities-section h2,
  .features-section h2,
  .spaces-section h2,
  .policies-section h2 {
    color: #fff;
    font-size: 2rem;
    margin-bottom: 1.5rem;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .amenity-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(255, 107, 53, 0.05));
    border-radius: 12px;
    border: 1px solid #333;
    transition: all 0.3s ease;
  }

  .amenity-item:hover {
    border-color: #0EA5E9;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(14, 165, 233, 0.2);
  }

  .amenity-name {
    color: #fff;
    font-size: 1rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .feature-item {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid #333;
    color: #b0b0b0;
  }

  .check-icon {
    width: 20px;
    height: 20px;
    color: #10B981;
    flex-shrink: 0;
  }

  .spaces-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .space-card {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(255, 107, 53, 0.05));
    padding: 2rem;
    border-radius: 12px;
    text-align: center;
    border: 1px solid #333;
    transition: all 0.3s ease;
  }

  .space-card:hover {
    border-color: #0EA5E9;
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(14, 165, 233, 0.2);
  }

  .space-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .space-card h3 {
    color: #fff;
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
  }

  .space-card p {
    color: #888;
  }

  .policies-list {
    display: grid;
    gap: 1rem;
  }

  .policy-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    border: 1px solid #333;
    color: #b0b0b0;
  }

  .policy-item strong {
    color: #0EA5E9;
    display: block;
    margin-bottom: 0.3rem;
  }

  .info-icon {
    width: 24px;
    height: 24px;
    color: #0EA5E9;
    flex-shrink: 0;
  }

  /* Sidebar de reserva en Hero */
  .hero-sidebar {
    position: sticky;
    top: 100px;
    align-self: start;
    height: fit-content;
    min-width: 350px;
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  /* Sidebar de reserva en contenido */
  .sidebar-booking {
    display: none;
  }

  .booking-card {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(255, 107, 53, 0.05));
    border: 1px solid #333;
    border-radius: 16px;
    padding: 2rem;
  }

  .reserve-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    background: linear-gradient(145deg, #FF6B35, #FF8A50);
    color: white;
    border: none;
    padding: 1.2rem;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1.1rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 10px 30px rgba(255, 107, 53, 0.4);
  }

  .reserve-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(255, 107, 53, 0.6);
  }

  .contact-info {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #333;
  }

  .info-title {
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 1rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #0EA5E9;
    text-decoration: none;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
    transition: color 0.3s;
  }

  .contact-link:hover {
