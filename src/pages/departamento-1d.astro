  }

  /* Responsive */
  @media (max-width: 1024px) {
    .hero-gallery {
      grid-template-columns: 1fr;
      max-width: 100%;
    }

    .gallery-main-area {
      max-width: 100%;
    }

    .main-image-container {
      max-width: 100%;
    }

    .thumbnails-container {
      max-width: 100%;
    }

    .hero-sidebar {
      display: none;
    }

    .info-container {
      grid-template-columns: 1fr;
    }

    .sidebar-booking {
      display: block;
      position: static;
    }
  }

  @media (max-width: 768px) {
    .hotel-detail {
      padding-top: 70px;
      overflow-x: hidden;
      width: 100%;
      max-width: 100vw;
    }

    .hero-header {
      padding: 1.5rem 1rem;
      width: 100%;
      box-sizing: border-box;
    }

    .hotel-title {
      font-size: 2rem;
    }

    .hotel-subtitle {
      font-size: 1rem;
    }

    .hero-gallery {
      padding: 0 1rem;
      gap: 0.8rem;
      width: 100%;
      max-width: 100vw;
      box-sizing: border-box;
      overflow-x: hidden;
    }

    .gallery-main-area {
      width: 100%;
      max-width: calc(100vw - 2rem);
      box-sizing: border-box;
    }

    .main-image-container {
      width: 100%;
      max-width: 100%;
      height: 250px;
      border-radius: 12px;
      margin-bottom: 0.6rem;
      box-sizing: border-box;
    }

    .main-image {
      width: 100%;
      max-width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center;
    }

    .thumbnails-container {
      width: 100%;
      max-width: 100%;
      gap: 0.4rem;
      box-sizing: border-box;
      display: flex;
      align-items: center;
    }

    .thumbnails-scroll {
      gap: 0.4rem;
      scrollbar-width: thin;
      scrollbar-color: #0EA5E9 transparent;
      padding: 0.3rem 0;
      max-width: 100%;
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .thumbnails-scroll::-webkit-scrollbar {
      height: 4px;
      display: block;
    }

    .thumbnails-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 2px;
    }

    .thumbnails-scroll::-webkit-scrollbar-thumb {
      background: #0EA5E9;
      border-radius: 2px;
    }

    .thumbnail {
      width: 70px;
      height: 50px;
      border-radius: 6px;
      border-width: 2px;
      flex-shrink: 0;
    }

    .thumbnail-nav {
      width: 32px;
      height: 32px;
      font-size: 16px;
      flex-shrink: 0;
    }

    .booking-card {
      padding: 1.2rem;
      margin: 0 1rem;
    }

    .contact-info {
      margin-top: 1.2rem;
      padding-top: 1.2rem;
    }

    .reserve-button {
      padding: 0.9rem;
      font-size: 0.95rem;
    }

    .contact-link {
      font-size: 0.9rem;
    }

    .main-content {
      padding: 0 1rem;
    }

    .amenities-section,
    .features-section,
    .spaces-section,
    .policies-section {
