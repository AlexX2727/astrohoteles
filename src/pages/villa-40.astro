</style>

<script>
    function initGallery() {
        const mainImage = document.getElementById(
            "mainImage"
        ) as HTMLImageElement;
        const lazyImages = document.querySelectorAll(
            ".main-image.lazy"
        ) as NodeListOf<HTMLImageElement>;
        const thumbnails = document.querySelectorAll(".thumbnail");
        const prevBtn = document.getElementById("prevBtn");
        const nextBtn = document.getElementById("nextBtn");
        const thumbnailsScroll = document.getElementById("thumbnailsScroll");

        // Modal elements
        const modal = document.getElementById("imageModal");
        const modalImg = document.getElementById(
            "modalImage"
        ) as HTMLImageElement;
        const closeModal = document.getElementById("closeModal");
        const modalPrevBtn = document.getElementById("modalPrevBtn");
        const modalNextBtn = document.getElementById("modalNextBtn");

        let currentIndex = 0;
        let imagesArray: string[] = [];

        if (mainImage) imagesArray.push(mainImage.src);
        lazyImages.forEach((img) => {
            if (img.dataset.src) imagesArray.push(img.dataset.src);
        });

        function updateMainImage(index: number) {
            thumbnails.forEach((thumb) => thumb.classList.remove("active"));

            // Desactivar imagen actual
            const currentActive = document.querySelector(".main-image.active");
            if (currentActive) {
                currentActive.classList.remove("active");
            }

            // Activar nueva imagen
            if (index === 0) {
                mainImage.classList.add("active");
            } else {
                const targetImg = lazyImages[index - 1];
                if (targetImg) {
                    if (targetImg.dataset.src && !targetImg.src) {
                        targetImg.src = targetImg.dataset.src;
                    }
                    targetImg.classList.add("active");
                }
            }

            const activeThumb = thumbnails[index] as HTMLElement;
            if (activeThumb) {
                activeThumb.classList.add("active");
                activeThumb.scrollIntoView({
                    behavior: "smooth",
                    block: "nearest",
                    inline: "center",
                });
            }

            currentIndex = index;
        }

        // Modal functions
        function openModal(index: number) {
            if (!modal || !modalImg) return;
            modalImg.src = imagesArray[index];
            modal.classList.add("active");
            document.body.style.overflow = "hidden";
            currentIndex = index;
        }

        function closeImageModal() {
            if (!modal) return;
            modal.classList.remove("active");
            document.body.style.overflow = "";
        }

        function updateModalImage(index: number) {
            if (!modalImg) return;
            modalImg.src = imagesArray[index];
            currentIndex = index;
            updateMainImage(index);
        }

        // Event Listeners
        thumbnails.forEach((thumb, index) => {
            thumb.addEventListener("click", () => updateMainImage(index));
        });

        // Main image click for modal
        mainImage?.addEventListener("click", () => openModal(currentIndex));
        lazyImages.forEach((img, idx) => {
            img.addEventListener("click", () => openModal(idx + 1));
        });

        // Modal navigation
        closeModal?.addEventListener("click", closeImageModal);
        modal?.addEventListener("click", (e) => {
            if (e.target === modal) closeImageModal();
        });

        modalPrevBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            const newIndex =
                currentIndex === 0 ? imagesArray.length - 1 : currentIndex - 1;
            updateModalImage(newIndex);
        });

        modalNextBtn?.addEventListener("click", (e) => {
            e.stopPropagation();
            const newIndex =
                currentIndex === imagesArray.length - 1 ? 0 : currentIndex + 1;
            updateModalImage(newIndex);
        });

        // Keyboard navigation for modal
        document.addEventListener("keydown", (e) => {
            if (!modal?.classList.contains("active")) return;

            if (e.key === "Escape") closeImageModal();
            if (e.key === "ArrowLeft") {
                const newIndex =
                    currentIndex === 0
                        ? imagesArray.length - 1
                        : currentIndex - 1;
                updateModalImage(newIndex);
            }
            if (e.key === "ArrowRight") {
                const newIndex =
                    currentIndex === imagesArray.length - 1
                        ? 0
                        : currentIndex + 1;
                updateModalImage(newIndex);
            }
        });

        prevBtn?.addEventListener("click", () => {
            const newIndex =
                currentIndex === 0 ? imagesArray.length - 1 : currentIndex - 1;
            updateMainImage(newIndex);
        });

        nextBtn?.addEventListener("click", () => {
            const newIndex =
                currentIndex === imagesArray.length - 1 ? 0 : currentIndex + 1;
            updateMainImage(newIndex);
        });

        // Intersection Observer for lazy loading nearby images
        if ("IntersectionObserver" in window) {
            const imageObserver = new IntersectionObserver(
                (entries, observer) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            const img = entry.target as HTMLImageElement;
                            if (img.dataset.src) {
                                img.src = img.dataset.src;
                                img.removeAttribute("data-src");
                            }
                            observer.unobserve(img);
                        }
                    });
                }
            );

            lazyImages.forEach((img) => imageObserver.observe(img));
        }
    }

    document.addEventListener("astro:page-load", initGallery);
    if (document.readyState === "complete") {
        initGallery();
    } else {
        document.addEventListener("DOMContentLoaded", initGallery);
    }
</script>
