---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hotel Chaqana - Salinas">
  <section class="hotel-detail">
    <!-- Header con título -->
    <div class="hero-header">
      <h1 class="hotel-title">Hotel Chaqana</h1>
      <p class="hotel-subtitle">Confort y elegancia en el corazón de Salinas</p>
    </div>

    <!-- Collage de imágenes -->
    <div class="image-gallery">
      <div class="gallery-main">
        <img
          src="/images/hoteles/Chaqana/IMG_2898.jpg"
          alt="Vista principal Hotel Chaqana"
          loading="lazy"
        />
      </div>
      <div class="gallery-grid">
        <img src="/images/hoteles/Chaqana/IMG_2943.jpg" alt="Vista del hotel" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2944.jpg" alt="Habitación confortable" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2946.jpg" alt="Amenidades" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2950.jpg" alt="Áreas comunes" loading="lazy" />
      </div>
      <button class="view-all-photos" id="view-gallery">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        Ver todas las fotos
      </button>
    </div>

    <!-- Contenido principal -->
    <div class="content-wrapper">
      <div class="main-content">
        <!-- Descripción -->
        <div class="section">
          <h2>Sobre el Hotel Chaqana</h2>
          <p class="description">
            El <strong>Hotel Chaqana</strong> representa la perfecta combinación entre lujo y comodidad
            en Salinas. Nuestro nombre, inspirado en la cruz del sur andina (Chakana), simboliza
            la armonía y el equilibrio que encontrarás en cada rincón de nuestras instalaciones.
          </p>
          <p class="description">
            Con <strong>departamentos totalmente equipados</strong> y acabados de primera calidad,
            te ofrecemos una experiencia única de hospedaje. Disfruta de espectaculares vistas al océano,
            piscina privada, internet de alta velocidad y todas las comodidades que mereces para
            unas vacaciones inolvidables.
          </p>
        </div>

        <!-- Características destacadas -->
        <div class="section">
          <h2>Características Destacadas</h2>
          <div class="features-grid">
            <div class="feature-card">
              <div class="feature-icon">🌊</div>
              <h3>Vista Panorámica</h3>
            </div>
            <div class="feature-card">
              <div class="feature-icon">🏊‍♂️</div>
              <h3>Piscina Privada</h3>
            </div>
            <div class="feature-card">
              <div class="feature-icon">📶</div>
              <h3>WiFi Premium</h3>
            </div>
            <div class="feature-card">
              <div class="feature-icon">🅿️</div>
              <h3>Estacionamiento</h3>
            </div>
            <div class="feature-card">
              <div class="feature-icon">✨</div>
              <h3>Lujo y Confort</h3>
            </div>
            <div class="feature-card">
              <div class="feature-icon">🔒</div>
              <h3>Seguridad Total</h3>
            </div>
          </div>
        </div>

        <!-- Ubicación -->
        <div class="section">
          <h2>Ubicación Privilegiada</h2>
          <p class="description">
            El Hotel Chaqana goza de una ubicación estratégica en Salinas, ofreciéndote
            fácil acceso a las mejores playas y atractivos turísticos de la zona.
          </p>
          <div class="location-features">
            <div class="location-item">🏖️ A 3 minutos caminando de la playa</div>
            <div class="location-item">🍽️ Zona gastronómica a 5 minutos</div>
            <div class="location-item">🛒 Supermercados y comercios cercanos</div>
            <div class="location-item">⛵ Puerto deportivo a 8 minutos</div>
            <div class="location-item">🌅 La Chocolatera a 15 minutos en auto</div>
            <div class="location-item">🏪 Centro comercial a 10 minutos</div>
          </div>
        </div>

        <!-- Información adicional -->
        <div class="section">
          <h2>Políticas del Hotel</h2>
          <div class="policies">
            <div class="policy-item">
              <strong>Check-in:</strong> A partir de las 14:00
            </div>
            <div class="policy-item">
              <strong>Check-out:</strong> Hasta las 12:00
            </div>
            <div class="policy-item">
              <strong>Mascotas:</strong> Consultar disponibilidad
            </div>
            <div class="policy-item">
              <strong>Fumadores:</strong> Prohibido fumar en áreas comunes
            </div>
            <div class="policy-item">
              <strong>Niños:</strong> Bienvenidos (consultar tarifas)
            </div>
            <div class="policy-item">
              <strong>Cancelación:</strong> Gratuita hasta 48h antes
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar con reserva -->
      <div class="sidebar-booking">
        <div class="booking-card">
          <div class="booking-details">
            <div class="detail-row">
              <span class="detail-icon">📍</span>
              <span>Salinas, Ecuador</span>
            </div>
            <div class="detail-row">
              <span class="detail-icon">🏠</span>
              <span>Departamentos de lujo</span>
            </div>
            <div class="detail-row">
              <span class="detail-icon">👥</span>
              <span>Capacidad: 2-8 personas</span>
            </div>
          </div>

          <a
            href="https://wa.me/593996779325?text=Hola, estoy interesado en reservar en Hotel Chaqana"
            target="_blank"
            rel="noopener"
            class="reserve-button"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Reservar
          </a>

          
        </div>
      </div>
    </div>
  </section>

  <!-- Modal para galería completa -->
  <div id="gallery-modal" class="gallery-modal" hidden>
    <div class="modal-content">
      <button class="modal-close" id="close-gallery">×</button>
      <div class="modal-gallery">
        <img src="/images/hoteles/Chaqana/IMG_2559.jpg" alt="Foto 1" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2560.jpg" alt="Foto 2" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2563.jpg" alt="Foto 3" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2566.jpg" alt="Foto 4" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2568.jpg" alt="Foto 5" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2570.jpg" alt="Foto 6" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2572.jpg" alt="Foto 7" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2574.jpg" alt="Foto 8" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2583.jpg" alt="Foto 9" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2585.jpg" alt="Foto 10" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2586.jpg" alt="Foto 11" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2898.jpg" alt="Foto 12" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2943.jpg" alt="Foto 13" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2944.jpg" alt="Foto 14" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2946.jpg" alt="Foto 15" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2950.jpg" alt="Foto 16" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2952.jpg" alt="Foto 17" loading="lazy" />
      </div>
    </div>
  </div>
</Layout>

<style>
  .hotel-detail {
    background: #080a0f;
    color: #fff;
    min-height: 100vh;
    padding-top: 80px;
  }

  /* Header */
  .hero-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
  }

  .hotel-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(135deg, #4a9abb, #5db8d4, #FFFFFF);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
    font-weight: 900;
  }

  .hotel-subtitle {
    font-size: 1.2rem;
    color: #94a3b8;
    margin-bottom: 2rem;
  }

  /* Galería de imágenes */
  .image-gallery {
    max-width: 1400px;
    margin: 2rem auto;
    padding: 0 2rem;
    position: relative;
  }

  .gallery-main {
    width: 100%;
    height: 500px;
    margin-bottom: 1rem;
    border-radius: 16px;
    overflow: hidden;
  }

  .gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .gallery-grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .gallery-grid img:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(74, 154, 187, 0.4);
  }

  .view-all-photos {
    position: absolute;
    bottom: 1.5rem;
    right: 2.5rem;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(10px);
    color: #fff;
    border: 1px solid #4a9abb;
    padding: 0.8rem 1.5rem;
    border-radius: 50px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
    font-weight: 600;
  }

  .view-all-photos:hover {
    background: #4a9abb;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(74, 154, 187, 0.5);
  }

  /* Contenido */
  .content-wrapper {
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 3rem;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: 5rem;
  }

  .section h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .description {
    color: #94a3b8;
    line-height: 1.8;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: linear-gradient(135deg, rgba(74, 154, 187, 0.1), rgba(224, 112, 64, 0.05));
    border: 1px solid #1e2738;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
  }

  .feature-card:hover {
    border-color: #4a9abb;
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(74, 154, 187, 0.2);
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.3rem;
    margin: 0;
    color: #fff;
  }

  /* Ubicación */
  .location-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .location-item {
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 8px;
    border-left: 3px solid #4a9abb;
    font-size: 1rem;
  }

  /* Políticas */
  .policies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .policy-item {
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid #1e2738;
    font-size: 0.95rem;
  }

  .policy-item strong {
    color: #4a9abb;
    display: block;
    margin-bottom: 0.3rem;
  }

  /* Sidebar de reserva */
  .sidebar-booking {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .booking-card {
    background: linear-gradient(135deg, rgba(74, 154, 187, 0.1), rgba(224, 112, 64, 0.05));
    border: 1px solid #1e2738;
    border-radius: 16px;
    padding: 2rem;
  }

  .booking-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .detail-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1rem;
  }

  .detail-icon {
    font-size: 1.3rem;
  }

  .reserve-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    background: #c85e35;
    color: white;
    border: none;
    padding: 1.2rem;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1.1rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: none;
  }

  .reserve-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(224, 112, 64, 0.6);
  }

  .contact-info {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #1e2738;
  }

  .info-title {
    font-size: 0.9rem;
    color: #6b7a8d;
    margin-bottom: 1rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #4a9abb;
    text-decoration: none;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
    transition: color 0.3s;
  }

  .contact-link:hover {
    color: #fff;
  }

  /* Modal de galería */
  .gallery-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 2rem;
  }

  .gallery-modal[hidden] {
    display: none;
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 1200px;
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-close {
    position: fixed;
    top: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    background: rgba(0,0,0,0.8);
    border: 2px solid #fff;
    color: #fff;
    font-size: 2rem;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2001;
    transition: all 0.3s;
  }

  .modal-close:hover {
    background: #4a9abb;
    transform: rotate(90deg);
  }

  .modal-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .modal-gallery img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 12px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .sidebar-booking {
      position: static;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hotel-detail {
      padding-top: 70px;
    }

    .gallery-main {
      height: 300px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-grid img {
      height: 150px;
    }

    .view-all-photos {
      bottom: 1rem;
      right: 1rem;
      font-size: 0.9rem;
      padding: 0.6rem 1rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .modal-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const viewGalleryBtn = document.getElementById('view-gallery');
    const galleryModal = document.getElementById('gallery-modal');
    const closeGalleryBtn = document.getElementById('close-gallery');

    if (viewGalleryBtn && galleryModal && closeGalleryBtn) {
      viewGalleryBtn.addEventListener('click', () => {
        galleryModal.hidden = false;
        document.body.style.overflow = 'hidden';
      });

      closeGalleryBtn.addEventListener('click', () => {
        galleryModal.hidden = true;
        document.body.style.overflow = 'auto';
      });

      galleryModal.addEventListener('click', (e) => {
        if (e.target === galleryModal) {
          galleryModal.hidden = true;
          document.body.style.overflow = 'auto';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !galleryModal.hidden) {
          galleryModal.hidden = true;
          document.body.style.overflow = 'auto';
        }
      });
    }
  });
</script>
</Layout>
