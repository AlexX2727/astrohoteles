---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Hotel Chaqana - Salinas">
  <section class="hotel-detail">
    <!-- Header con título y breadcrumb -->
    <div class="hero-header">
      <div class="breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/#mapa">Hoteles</a>
        <span>/</span>
        <span>Chaqana</span>
      </div>
      <h1 class="hotel-title">Hotel Chaqana</h1>
      <p class="hotel-subtitle">Confort y elegancia en el corazón de Salinas</p>
      <div class="hotel-rating">
        <div class="stars">
          ⭐⭐⭐⭐⭐
        </div>
        <span class="rating-score">9.7 Excepcional</span>
      </div>
    </div>

    <!-- Collage de imágenes -->
    <div class="image-gallery">
      <div class="gallery-main">
        <img
          src="/images/hoteles/Chaqana/IMG_2559.jpg"
          alt="Vista principal Hotel Chaqana"
          loading="lazy"
        />
      </div>
      <div class="gallery-grid">
        <img src="/images/hoteles/Chaqana/IMG_2560.jpg" alt="Vista del hotel" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2563.jpg" alt="Habitación confortable" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2566.jpg" alt="Amenidades" loading="lazy" />
        <img src="/images/hoteles/Chaqana/IMG_2568.jpg" alt="Áreas comunes" loading="lazy" />
      </div>
      <button class="view-all-photos" id="view-gallery">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <circle cx="8.5" cy="8.5" r="1.5"></circle>
          <polyline points="21 15 16 10 5 21"></polyline>
        </svg>
        Ver todas las fotos
      </button>
    </div>

    <!-- Contenido principal -->
    <div class="content-wrapper">
      <div class="main-content">
        <!-- Descripción -->
        <div class="section">
          <h2>Sobre el Hotel Chaqana</h2>
          <p class="description">
            El <strong>Hotel Chaqana</strong> representa la perfecta combinación entre lujo y comodidad
            en Salinas. Nuestro nombre, inspirado en la cruz del sur andina (Chakana), simboliza
            la armonía y el equilibrio que encontrarás en cada rincón de nuestras instalaciones.
          </p>
          <p class="description">
            Con <strong>departamentos totalmente equipados</strong> y acabados de primera calidad,
            te ofrecemos una experiencia única de hospedaje. Disfruta de espectaculares vistas al océano,
            piscina privada, internet de alta velocidad y todas las comodidades que mereces para
            unas vacaciones inolvidables.
          </p>
        </div>

        <!-- Características destacadas -->
        <div class="section">
          <h2>Características Destacadas</h2>
          <div class="features-grid">
            <div class="feature-card">
              <div class="feature-icon">🌊</div>
              <h3>Vista Panorámica</h3>
              <p>Impresionantes vistas al mar desde todos nuestros departamentos</p>
            </div>
            <div class="feature-card">
              <div class="feature-icon">🏊‍♂️</div>
              <h3>Piscina Privada</h3>
              <p>Disfruta de nuestra piscina exclusiva para huéspedes</p>
            </div>
            <div class="feature-card">
              <div class="feature-icon">📶</div>
              <h3>WiFi Premium</h3>
              <p>Internet de alta velocidad en todas las instalaciones</p>
            </div>
            <div class="feature-card">
              <div class="feature-icon">🅿️</div>
              <h3>Estacionamiento</h3>
              <p>Parqueadero privado y vigilado 24/7</p>
            </div>
            <div class="feature-card">
              <div class="feature-icon">✨</div>
              <h3>Lujo y Confort</h3>
              <p>Acabados premium y muebles de primera calidad</p>
            </div>
            <div class="feature-card">
              <div class="feature-icon">🔒</div>
              <h3>Seguridad Total</h3>
              <p>Acceso controlado y seguridad las 24 horas</p>
            </div>
          </div>
        </div>

        <!-- Amenidades -->
        <div class="section">
          <h2>Amenidades</h2>
          <div class="amenities-list">
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M9 21V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v15"></path>
                <path d="M3 10h18"></path>
                <path d="M3 6h18v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6z"></path>
              </svg>
              <span>Cocina completamente equipada</span>
            </div>
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
                <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
              </svg>
              <span>Aire acondicionado y ventilación</span>
            </div>
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
              <span>Caja de seguridad digital</span>
            </div>
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 16V8a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8"></path>
                <rect x="4" y="16" width="16" height="2"></rect>
              </svg>
              <span>Smart TV con cable</span>
            </div>
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              <span>Terraza con vista al mar</span>
            </div>
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"></circle>
                <path d="M12 1v6m0 6v6m8.66-9l-5.2 3m-6.92 4l-5.2 3M20.66 17l-5.2-3m-6.92-4l-5.2-3"></path>
              </svg>
              <span>Agua caliente 24/7</span>
            </div>
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                <rect x="9" y="9" width="6" height="6"></rect>
                <line x1="9" y1="1" x2="9" y2="4"></line>
                <line x1="15" y1="1" x2="15" y2="4"></line>
                <line x1="9" y1="20" x2="9" y2="23"></line>
                <line x1="15" y1="20" x2="15" y2="23"></line>
              </svg>
              <span>Lavadora y secadora</span>
            </div>
            <div class="amenity-item">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M18 8h1a4 4 0 0 1 0 8h-1"></path>
                <path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"></path>
                <line x1="6" y1="1" x2="6" y2="4"></line>
                <line x1="10" y1="1" x2="10" y2="4"></line>
                <line x1="14" y1="1" x2="14" y2="4"></line>
              </svg>
              <span>Utensilios de cocina premium</span>
            </div>
          </div>
        </div>

        <!-- Ubicación -->
        <div class="section">
          <h2>Ubicación Privilegiada</h2>
          <p class="description">
            El Hotel Chaqana goza de una ubicación estratégica en Salinas, ofreciéndote
            fácil acceso a las mejores playas y atractivos turísticos de la zona.
          </p>
          <div class="location-features">
            <div class="location-item">🏖️ A 3 minutos caminando de la playa</div>
            <div class="location-item">🍽️ Zona gastronómica a 5 minutos</div>
            <div class="location-item">🛒 Supermercados y comercios cercanos</div>
            <div class="location-item">⛵ Puerto deportivo a 8 minutos</div>
            <div class="location-item">🌅 La Chocolatera a 15 minutos en auto</div>
            <div class="location-item">🏪 Centro comercial a 10 minutos</div>
          </div>
        </div>

        <!-- Información adicional -->
        <div class="section">
          <h2>Políticas del Hotel</h2>
          <div class="policies">
            <div class="policy-item">
              <strong>Check-in:</strong> A partir de las 14:00
            </div>
            <div class="policy-item">
              <strong>Check-out:</strong> Hasta las 12:00
            </div>
            <div class="policy-item">
              <strong>Mascotas:</strong> Consultar disponibilidad
            </div>
            <div class="policy-item">
              <strong>Fumadores:</strong> Prohibido fumar en áreas comunes
            </div>
            <div class="policy-item">
              <strong>Niños:</strong> Bienvenidos (consultar tarifas)
            </div>
            <div class="policy-item">
              <strong>Cancelación:</strong> Gratuita hasta 48h antes
            </div>
          </div>
        </div>
      </div>

      <!-- Sidebar con reserva -->
      <div class="sidebar-booking">
        <div class="booking-card">
          <div class="price-section">
            <span class="price-label">Desde</span>
            <div class="price">$110<span class="price-unit">/noche</span></div>
          </div>

          <div class="booking-details">
            <div class="detail-row">
              <span class="detail-icon">📍</span>
              <span>Salinas, Ecuador</span>
            </div>
            <div class="detail-row">
              <span class="detail-icon">🏠</span>
              <span>Departamentos de lujo</span>
            </div>
            <div class="detail-row">
              <span class="detail-icon">👥</span>
              <span>Capacidad: 2-8 personas</span>
            </div>
            <div class="detail-row">
              <span class="detail-icon">⭐</span>
              <span>Rating: 9.7/10 Excepcional</span>
            </div>
          </div>

          <a
            href="https://wa.me/593996779325?text=Hola, estoy interesado en reservar en Hotel Chaqana"
            target="_blank"
            rel="noopener"
            class="reserve-button"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
            </svg>
            Reservar por WhatsApp
          </a>

          <div class="contact-info">
            <p class="info-title">¿Tienes preguntas?</p>
            <a href="mailto:reservas@hospedajesalinas.com" class="contact-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              reservas@hospedajesalinas.com
            </a>
            <a href="tel:+593996779325" class="contact-link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              +593 99 677 9325
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modal para galería completa -->
  <div id="gallery-modal" class="gallery-modal" hidden>
    <div class="modal-content">
      <button class="modal-close" id="close-gallery">×</button>
      <div class="modal-gallery">
        <img src="/images/hoteles/Chaqana/IMG_2559.jpg" alt="Foto 1" />
        <img src="/images/hoteles/Chaqana/IMG_2560.jpg" alt="Foto 2" />
        <img src="/images/hoteles/Chaqana/IMG_2563.jpg" alt="Foto 3" />
        <img src="/images/hoteles/Chaqana/IMG_2566.jpg" alt="Foto 4" />
        <img src="/images/hoteles/Chaqana/IMG_2568.jpg" alt="Foto 5" />
        <img src="/images/hoteles/Chaqana/IMG_2570.jpg" alt="Foto 6" />
        <img src="/images/hoteles/Chaqana/IMG_2572.jpg" alt="Foto 7" />
        <img src="/images/hoteles/Chaqana/IMG_2574.jpg" alt="Foto 8" />
        <img src="/images/hoteles/Chaqana/IMG_2583.jpg" alt="Foto 9" />
        <img src="/images/hoteles/Chaqana/IMG_2585.jpg" alt="Foto 10" />
        <img src="/images/hoteles/Chaqana/IMG_2586.jpg" alt="Foto 11" />
      </div>
    </div>
  </div>
</Layout>

<style>
  .hotel-detail {
    background: #000;
    color: #fff;
    min-height: 100vh;
    padding-top: 80px;
  }

  /* Header */
  .hero-header {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    text-align: center;
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
    color: #888;
  }

  .breadcrumb a {
    color: #0EA5E9;
    text-decoration: none;
    transition: color 0.3s;
  }

  .breadcrumb a:hover {
    color: #fff;
  }

  .hotel-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    background: linear-gradient(135deg, #0EA5E9, #22D3EE, #FFFFFF);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin-bottom: 0.5rem;
    font-weight: 900;
  }

  .hotel-subtitle {
    font-size: 1.2rem;
    color: #b0b0b0;
    margin-bottom: 1rem;
  }

  .hotel-rating {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    font-size: 1.1rem;
  }

  .stars {
    color: #FFD700;
  }

  .rating-score {
    background: linear-gradient(135deg, #0EA5E9, #06B6D4);
    padding: 0.5rem 1rem;
    border-radius: 50px;
    font-weight: 700;
  }

  /* Galería de imágenes */
  .image-gallery {
    max-width: 1400px;
    margin: 2rem auto;
    padding: 0 2rem;
    position: relative;
  }

  .gallery-main {
    width: 100%;
    height: 500px;
    margin-bottom: 1rem;
    border-radius: 16px;
    overflow: hidden;
  }

  .gallery-main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .gallery-grid img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 12px;
    cursor: pointer;
    transition: transform 0.3s, box-shadow 0.3s;
  }

  .gallery-grid img:hover {
    transform: scale(1.05);
    box-shadow: 0 8px 25px rgba(14, 165, 233, 0.4);
  }

  .view-all-photos {
    position: absolute;
    bottom: 1.5rem;
    right: 2.5rem;
    background: rgba(0,0,0,0.8);
    backdrop-filter: blur(10px);
    color: #fff;
    border: 1px solid #0EA5E9;
    padding: 0.8rem 1.5rem;
    border-radius: 50px;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: all 0.3s;
    font-weight: 600;
  }

  .view-all-photos:hover {
    background: #0EA5E9;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(14, 165, 233, 0.5);
  }

  /* Contenido */
  .content-wrapper {
    max-width: 1400px;
    margin: 3rem auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr 400px;
    gap: 3rem;
  }

  .main-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .section h2 {
    font-size: 2rem;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .description {
    color: #b0b0b0;
    line-height: 1.8;
    font-size: 1.1rem;
    margin-bottom: 1rem;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(255, 107, 53, 0.05));
    border: 1px solid #333;
    border-radius: 12px;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
  }

  .feature-card:hover {
    border-color: #0EA5E9;
    transform: translateY(-5px);
    box-shadow: 0 10px 30px rgba(14, 165, 233, 0.2);
  }

  .feature-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-size: 1.3rem;
    margin-bottom: 0.5rem;
    color: #fff;
  }

  .feature-card p {
    color: #888;
    font-size: 0.95rem;
  }

  /* Amenidades */
  .amenities-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .amenity-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid #333;
    transition: all 0.3s;
  }

  .amenity-item:hover {
    border-color: #0EA5E9;
    background: rgba(14, 165, 233, 0.1);
  }

  .amenity-item svg {
    color: #0EA5E9;
    flex-shrink: 0;
  }

  /* Ubicación */
  .location-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .location-item {
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 8px;
    border-left: 3px solid #0EA5E9;
    font-size: 1rem;
  }

  /* Políticas */
  .policies {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
  }

  .policy-item {
    background: rgba(255, 255, 255, 0.05);
    padding: 1rem;
    border-radius: 8px;
    border: 1px solid #333;
    font-size: 0.95rem;
  }

  .policy-item strong {
    color: #0EA5E9;
    display: block;
    margin-bottom: 0.3rem;
  }

  /* Sidebar de reserva */
  .sidebar-booking {
    position: sticky;
    top: 100px;
    height: fit-content;
  }

  .booking-card {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(255, 107, 53, 0.05));
    border: 1px solid #333;
    border-radius: 16px;
    padding: 2rem;
  }

  .price-section {
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid #333;
  }

  .price-label {
    color: #888;
    font-size: 0.9rem;
    display: block;
    margin-bottom: 0.5rem;
  }

  .price {
    font-size: 3rem;
    font-weight: 900;
    color: #0EA5E9;
  }

  .price-unit {
    font-size: 1.2rem;
    color: #888;
  }

  .booking-details {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .detail-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    font-size: 1rem;
  }

  .detail-icon {
    font-size: 1.3rem;
  }

  .reserve-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    width: 100%;
    background: linear-gradient(145deg, #FF6B35, #FF8A50);
    color: white;
    border: none;
    padding: 1.2rem;
    border-radius: 50px;
    font-weight: 800;
    font-size: 1.1rem;
    cursor: pointer;
    text-decoration: none;
    transition: all 0.3s;
    box-shadow: 0 10px 30px rgba(255, 107, 53, 0.4);
  }

  .reserve-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 15px 40px rgba(255, 107, 53, 0.6);
  }

  .contact-info {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #333;
  }

  .info-title {
    font-size: 0.9rem;
    color: #888;
    margin-bottom: 1rem;
  }

  .contact-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #0EA5E9;
    text-decoration: none;
    margin-bottom: 0.8rem;
    font-size: 0.95rem;
    transition: color 0.3s;
  }

  .contact-link:hover {
    color: #fff;
  }

  /* Modal de galería */
  .gallery-modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2000;
    padding: 2rem;
  }

  .gallery-modal[hidden] {
    display: none;
  }

  .modal-content {
    position: relative;
    width: 100%;
    max-width: 1200px;
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-close {
    position: fixed;
    top: 2rem;
    right: 2rem;
    width: 50px;
    height: 50px;
    background: rgba(0,0,0,0.8);
    border: 2px solid #fff;
    color: #fff;
    font-size: 2rem;
    border-radius: 50%;
    cursor: pointer;
    z-index: 2001;
    transition: all 0.3s;
  }

  .modal-close:hover {
    background: #0EA5E9;
    transform: rotate(90deg);
  }

  .modal-gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .modal-gallery img {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 12px;
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .content-wrapper {
      grid-template-columns: 1fr;
    }

    .sidebar-booking {
      position: static;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .hotel-detail {
      padding-top: 70px;
    }

    .gallery-main {
      height: 300px;
    }

    .gallery-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .gallery-grid img {
      height: 150px;
    }

    .view-all-photos {
      bottom: 1rem;
      right: 1rem;
      font-size: 0.9rem;
      padding: 0.6rem 1rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }

    .modal-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const viewGalleryBtn = document.getElementById('view-gallery');
    const galleryModal = document.getElementById('gallery-modal');
    const closeGalleryBtn = document.getElementById('close-gallery');

    if (viewGalleryBtn && galleryModal && closeGalleryBtn) {
      viewGalleryBtn.addEventListener('click', () => {
        galleryModal.hidden = false;
        document.body.style.overflow = 'hidden';
      });

      closeGalleryBtn.addEventListener('click', () => {
        galleryModal.hidden = true;
        document.body.style.overflow = 'auto';
      });

      galleryModal.addEventListener('click', (e) => {
        if (e.target === galleryModal) {
          galleryModal.hidden = true;
          document.body.style.overflow = 'auto';
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !galleryModal.hidden) {
          galleryModal.hidden = true;
          document.body.style.overflow = 'auto';
        }
      });
    }
  });
</script>
</Layout>
