                    }

                    .reserve-button {
                        display: flex;
                        align-items: center;
                        justify-content: center;
                        gap: 0.8rem;
                        width: 100%;
                        padding: 1rem;
                        background: linear-gradient(145deg, #ff6b35, #ff8a50);
                        color: white;
                        text-decoration: none;
                        font-weight: 700;
                        font-size: 1.1rem;
                        border-radius: 16px;
                        transition: all 0.3s ease;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        box-shadow: 0 10px 30px rgba(255, 107, 53, 0.4);
                        position: relative;
                        overflow: hidden;
                        margin-bottom: 2rem;
                        border: none;
                    }

                    .reserve-button::before {
                        content: "";
                        position: absolute;
                        top: 0;
                        left: -100%;
                        width: 100%;
                        height: 100%;
                        background: linear-gradient(
                            90deg,
                            transparent,
                            rgba(255, 255, 255, 0.2),
                            transparent
                        );
                        transition: 0.5s;
                    }

                    .reserve-button:hover::before {
                        left: 100%;
                    }

                    .reserve-button:hover {
                        transform: translateY(-3px);
                        box-shadow: 0 15px 40px rgba(255, 107, 53, 0.6);
                        background: linear-gradient(145deg, #ff8a50, #ff6b35);
                    }

                    .contact-info {
                        display: flex;
                        flex-direction: column;
                        gap: 1rem;
                        border-top: 1px solid rgba(255, 255, 255, 0.1);
                        padding-top: 1.5rem;
                    }

                    .info-title {
                        color: #888;
                        font-size: 0.9rem;
                        text-transform: uppercase;
                        letter-spacing: 1px;
                        margin-bottom: 0.5rem;
                    }

                    .contact-link {
                        display: flex;
                        align-items: center;
                        gap: 0.8rem;
                        color: #39b9fc;
                        text-decoration: none;
                        font-size: 0.95rem;
                        transition: all 0.3s ease;
                        padding: 0.5rem;
                        border-radius: 8px;
                    }

                    .contact-link svg {
                        color: #39b9fc;
                        transition: all 0.3s ease;
                    }

                    .contact-link:hover {
                        background: rgba(255, 255, 255, 0.05);
                        color: #fff;
                        transform: translateX(5px);
                    }

                    .contact-link:hover svg {
                        color: #ff6b35;
                        transform: scale(1.1);
                    }

                    /* Responsive */
                    @media (max-width: 1024px) {
                        .info-container {
                            grid-template-columns: 1fr;
                            padding: 0 1.5rem;
                        }

                        .sidebar-booking {
                            position: static;
                            margin-top: 2rem;
                        }

                        .amenities-grid {
                            grid-template-columns: repeat(2, 1fr);
                            gap: 1rem;
                        }

                        .amenity-item {
                            padding: 1.2rem 1rem;
                            gap: 0.8rem;
                        }

                        .amenity-icon-large {
                            width: 48px;
                            height: 48px;
                        }

                        .amenity-name {
                            font-size: 0.9rem;
                        }

                        .description-text {
                            font-size: 1rem;
                            padding: 1.2rem;
                        }

                        .policy-item {
                            padding: 1rem;
                            gap: 0.8rem;
                        }

                        .policy-icon {
                            font-size: 1.3rem;
                        }
                    }

                    @media (max-width: 480px) {
                        .hero-title {
                            font-size: 1.8rem;
                        }

                        .hero-gallery {
                            padding: 0 0.8rem;
                            max-width: 100vw;
                            overflow-x: hidden;
                        }

                        .gallery-main-area {
                            max-width: calc(100vw - 1.6rem);
                        }

                        .main-image-container {
                            height: 220px;
                            border-radius: 8px;
                            width: 100%;
                            max-width: 100%;
                        }

                        .thumbnail {
                            width: 65px;
                            height: 48px;
                        }

                        .thumbnail-nav {
                            width: 30px;
                            height: 30px;
                            font-size: 14px;
                        }

                        .booking-card {
                            padding: 1rem;
                            margin: 0 0.5rem;
                        }

                        .reserve-button {
                            padding: 0.8rem;
                            font-size: 0.9rem;
                        }

                        .contact-link {
                            font-size: 0.85rem;
                        }

                        .amenities-grid {
                            grid-template-columns: 1fr;
                            gap: 0.8rem;
                        }

                        .amenity-item {
                            padding: 1rem 0.8rem;
                        }

                        .amenity-icon-large {
                            width: 40px;
                            height: 40px;
                        }

                        .amenity-name {
                            font-size: 0.85rem;
                        }

                        .info-section h2,
                        .description-section h2,
                        .policies-section h2 {
                            font-size: 1.3rem;
                        }

                        .main-content {
                            padding: 0 0.8rem;
                        }
                    }

                    @media (max-width: 768px) {
                        .modal-nav-btn {
                            display: none;
                        }
                    }
                </style>

                <script>
                    document.addEventListener("DOMContentLoaded", () => {
                        const mainImages =
                            document.querySelectorAll(".main-image");
                        const thumbnails =
                            document.querySelectorAll(".thumbnail");
                        const prevBtn = document.getElementById("prevBtn");
                        const nextBtn = document.getElementById("nextBtn");
                        const thumbnailsScroll =
                            document.getElementById("thumbnailsScroll");
                        let currentIndex = 0;
                        let autoplayInterval: ReturnType<
                            typeof setInterval
                        > | null = null;
                        const loadedImages = new Set<number>([0]); // Primera imagen ya cargada

                        // Función para cargar imagen bajo demanda
                        function loadImage(index: number) {
                            if (loadedImages.has(index)) return;

                            const imgElement = mainImages[
                                index
                            ] as HTMLImageElement;
                            const dataSrc = imgElement.getAttribute("data-src");

                            if (dataSrc && !imgElement.src) {
                                imgElement.src = dataSrc;
                                loadedImages.add(index);
                            }
                        }

                        // Pre-cargar imágenes cercanas
                        function preloadNearbyImages(index: number) {
                            // Cargar imagen actual y las 2 siguientes
                            for (let i = 0; i <= 2; i++) {
                                const nextIndex =
                                    (index + i) % mainImages.length;
                                loadImage(nextIndex);
                            }
                        }

                        function showImage(
                            index: number,
                            scroll: boolean = true,
                        ) {
                            // Cargar imagen antes de mostrarla
                            loadImage(index);
                            preloadNearbyImages(index);

                            mainImages.forEach((img) =>
                                img.classList.remove("active"),
                            );
                            thumbnails.forEach((thumb) =>
                                thumb.classList.remove("active"),
                            );

                            mainImages[index].classList.add("active");
                            thumbnails[index].classList.add("active");

                            // Scroll thumbnail into view without scrolling the page
                            if (scroll) {
                                const thumbnail = thumbnails[
                                    index
                                ] as HTMLElement;
                                const container = thumbnailsScroll;
                                if (container && thumbnail) {
                                    const containerRect =
                                        container.getBoundingClientRect();
                                    const thumbnailRect =
                                        thumbnail.getBoundingClientRect();
                                    const scrollLeft =
                                        thumbnail.offsetLeft -
                                        container.offsetLeft -
                                        containerRect.width / 2 +
                                        thumbnailRect.width / 2;
                                    container.scrollTo({
                                        left: scrollLeft,
                                        behavior: "smooth",
                                    });
                                }
                            }
                            currentIndex = index;
                        }

                        function showNextImage() {
                            const nextIndex =
                                (currentIndex + 1) % mainImages.length;
                            showImage(nextIndex);
                        }

                        function showPrevImage() {
                            const prevIndex =
                                (currentIndex - 1 + mainImages.length) %
                                mainImages.length;
                            showImage(prevIndex);
                        }

                        // Event Listeners
                        thumbnails.forEach((thumb, index) => {
                            thumb.addEventListener("click", () => {
                                showImage(index);
                                stopAutoplay();
                            });
                        });

                        prevBtn?.addEventListener("click", () => {
                            showPrevImage();
                            stopAutoplay();
                        });

                        nextBtn?.addEventListener("click", () => {
                            showNextImage();
                            stopAutoplay();
                        });

                        // Modal functionality
                        const modal = document.getElementById("imageModal");
                        const modalImage =
                            document.getElementById("modalImage");
                        const closeModal =
                            document.getElementById("closeModal");
                        const modalPrevBtn =
                            document.getElementById("modalPrevBtn");
                        const modalNextBtn =
                            document.getElementById("modalNextBtn");

                        // Touch events for swipe
                        let touchStartX = 0;
                        let touchEndX = 0;

                        modal?.addEventListener(
                            "touchstart",
                            (e) => {
                                touchStartX = e.changedTouches[0].screenX;
                            },
                            { passive: true },
                        );

                        modal?.addEventListener(
                            "touchmove",
                            (e) => {
                                touchEndX = e.changedTouches[0].screenX;
                            },
                            { passive: true },
                        );

                        modal?.addEventListener("touchend", () => {
                            handleSwipe();
                        });

                        function handleSwipe() {
                            const swipeThreshold = 50;
                            const swipeDistance = touchEndX - touchStartX;

                            if (Math.abs(swipeDistance) > swipeThreshold) {
                                if (swipeDistance > 0) {
                                    showPrevImage();
                                } else {
                                    showNextImage();
                                }
                                updateModalImage();
                            }
                        }

                        function openModal() {
                            if (modal && modalImage) {
                                modal.classList.add("active");
                                updateModalImage();
                                stopAutoplay();
                            }
                        }

                        function updateModalImage() {
                            if (modalImage) {
                                const currentImg = mainImages[
                                    currentIndex
                                ] as HTMLImageElement;
                                (modalImage as HTMLImageElement).src =
                                    currentImg.src ||
                                    currentImg.getAttribute("data-src") ||
                                    "";
                            }
                        }

                        mainImages.forEach((img) => {
                            img.addEventListener("click", openModal);
                        });

                        closeModal?.addEventListener("click", () => {
                            modal?.classList.remove("active");
                            startAutoplay();
                        });

                        modalPrevBtn?.addEventListener("click", (e) => {
                            e.stopPropagation();
                            showPrevImage();
                            updateModalImage();
                        });

                        modalNextBtn?.addEventListener("click", (e) => {
                            e.stopPropagation();
                            showNextImage();
                            updateModalImage();
                        });

                        // Close modal on background click
                        modal?.addEventListener("click", (e) => {
                            if (e.target === modal) {
                                modal.classList.remove("active");
                                startAutoplay();
                            }
                        });

                        // Keyboard navigation
                        document.addEventListener("keydown", (e) => {
                            if (!modal?.classList.contains("active")) return;

                            if (e.key === "Escape") {
                                modal.classList.remove("active");
                                startAutoplay();
                            } else if (e.key === "ArrowLeft") {
                                showPrevImage();
                                updateModalImage();
                            } else if (e.key === "ArrowRight") {
                                showNextImage();
                                updateModalImage();
                            }
                        });

                        function startAutoplay() {
                            if (!autoplayInterval) {
                                autoplayInterval = setInterval(
                                    showNextImage,
                                    5000,
                                );
                            }
                        }

                        function stopAutoplay() {
                            if (autoplayInterval) {
                                clearInterval(autoplayInterval);
                                autoplayInterval = null;
                            }
                        }

                        // Iniciar autoplay
                        startAutoplay();
                    });
                </script>
            </div>
        </section>
    </div>
</Layout>
