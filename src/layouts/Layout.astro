---
// src/layouts/Layout.astro
export interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
  <meta http-equiv="Pragma" content="no-cache" />
  <meta http-equiv="Expires" content="0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <title>{title}</title>

</head>

<body>
  <!-- Header -->
  <header class="header">
    <nav class="nav">
      <a href="/" class="logo-link">
        <img src="/images/logo.svg" alt="Hospedaje Salinas" class="logo-img" />
      </a>
      <ul class="nav-links" id="nav-links">
        <li><a href="/#inicio">Inicio</a></li>
        <li><a href="/#mapa">Hospedajes</a></li>
        <li><a href="#contacto">Contacto</a></li>
      </ul>
      <div class="hamburger" id="hamburger">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>
  <div class="nav-overlay" id="nav-overlay"></div>

  <!-- Contact modal -->
  <div id="contact-modal" class="contact-modal-overlay" hidden>
    <div class="contact-modal-dialog" role="dialog" aria-modal="true" aria-labelledby="contact-title">
      <button class="contact-close" id="contact-close" aria-label="Cerrar">×</button>
      <header class="contact-header">
        <h3 id="contact-title">Contáctanos</h3>
        <p>Estamos para ayudarte</p>
      </header>
      <div class="contact-body">
        <a class="contact-item" href="mailto:reservas@hospedajesalinas.com">
          <span class="contact-icon">✉️</span>
          <div>
            <strong>Reservas</strong>
            <div>reservas@hospedajesalinas.com</div>
          </div>
        </a>
        <a class="contact-item" href="mailto:info@hospedajesalinas.com">
          <span class="contact-icon">📧</span>
          <div>
            <strong>Información</strong>
            <div>Info@hospedajesalinas.com</div>
          </div>
        </a>
        <a class="contact-item" href="https://wa.me/593996779325?text=Hola%2C%20me%20gustar%C3%ADa%20obtener%20informaci%C3%B3n%20sobre%20alojamientos" target="_blank" rel="noopener">
          <span class="contact-icon">📞</span>
          <div>
            <strong>WhatsApp</strong>
            <div>+593 99 677 9325</div>
          </div>
        </a>
      </div>
    </div>
  </div>

  <main>
    <slot />
  </main>
</body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background-color: #080a0f;
    color: #e8ecf1;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
  }

  /* Custom scrollbar */
  ::-webkit-scrollbar {
    width: 8px;
  }
  ::-webkit-scrollbar-track {
    background: #0c0e14;
  }
  ::-webkit-scrollbar-thumb {
    background: #1e2738;
    border-radius: 4px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #2a3548;
  }

  /* Evitar scroll cuando el menú está abierto */
  body.menu-open {
    overflow: hidden;
  }

  /* Overlay para el menú móvil */
  .nav-overlay {
    position: fixed;
    inset: 0;
    background: rgba(6, 8, 12, 0.7);
    backdrop-filter: blur(4px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
    z-index: 900;
  }
  .nav-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  /* Contact modal */
  .contact-modal-overlay {
    position: fixed;
    inset: 0;
    /* Fondo transparente para no oscurecer toda la página */
    background: transparent;
    display: flex;
    align-items: end;
    justify-content: end;
    padding: 16px;
    z-index: 2000;
    pointer-events: none; /* solo el panel recibe clicks */
  }
  .contact-modal-overlay[hidden] { display: none !important; }

  .contact-modal-dialog {
    position: relative;
    width: min(92vw, 420px);
    background: #0e1118;
    border: 1px solid #1e2738;
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.03);
    pointer-events: auto;
    animation: contactSlideUp .3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes contactSlideUp { from { transform: translateY(16px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }

  .contact-header {
    background: linear-gradient(135deg, rgba(74,154,187,0.12), rgba(224,112,64,0.06));
    padding: 18px 20px;
    border-bottom: 1px solid #1e2738;
  }
  .contact-header h3 { margin: 0 0 4px 0; color: #e8ecf1; font-weight: 700; font-size: 1.1rem; }
  .contact-header p { margin: 0; color: #94a3b8; font-size: 0.88rem; }

  .contact-body { padding: 12px; display: grid; gap: 8px; }
  .contact-item {
    display: flex; gap: 12px; align-items: center; text-decoration: none;
    background: rgba(255,255,255,0.02); border: 1px solid #1e2738; border-radius: 12px;
    padding: 14px 16px; color: #c8d1dc; transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .contact-item:hover { border-color: #4a9abb; transform: translateY(-2px); background: rgba(74,154,187,0.06); }
  .contact-icon { font-size: 1.3rem; filter: drop-shadow(0 2px 4px rgba(0,0,0,.3)); }

  .contact-close {
    position: absolute; top: 12px; right: 12px;
    width: 32px; height: 32px; border-radius: 50%;
    border: 1px solid #1e2738; background: rgba(8,10,15,0.8); color: #94a3b8;
    cursor: pointer; transition: all 0.2s ease;
    display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
  }
  .contact-close:hover { background: #1e2738; color: #e8ecf1; }

  /* Header */
  .header {
    position: fixed;
    top: 0;
    width: 100%;
    background: rgba(8, 10, 15, 0.85);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    z-index: 1000;
    padding: 0.4rem 1rem;
    border-bottom: 1px solid rgba(30, 39, 56, 0.5);
    transition: background 0.4s ease, box-shadow 0.4s ease;
  }

  .header.scrolled {
    background: rgba(8, 10, 15, 0.95);
    box-shadow: 0 4px 30px rgba(0, 0, 0, 0.3);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    width: 100%;
  }

  .logo-link {
    display: block;
    text-decoration: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .logo-link:hover {
    opacity: 0.85;
    transform: scale(1.02);
  }

  .logo-img {
    height: 70px;
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    list-style: none;
    gap: 2.5rem;
  }

  .nav-links a {
    color: #94a3b8;
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.4px;
    position: relative;
    padding: 0.3rem 0;
    transition: color 0.3s ease;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -2px;
    left: 0;
    width: 100%;
    height: 2px;
    background: #4a9abb;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 1px;
  }

  .nav-links a:hover {
    color: #e8ecf1;
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .hamburger {
    display: none;
    flex-direction: column;
    cursor: pointer;
    padding: 0.5rem;
    gap: 1px;
  }

  .hamburger span {
    width: 24px;
    height: 2px;
    background: #94a3b8;
    margin: 3px 0;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    border-radius: 2px;
  }

  .hamburger:hover span {
    background: #e8ecf1;
  }

  .hamburger.active span:nth-child(1) {
    transform: rotate(-45deg) translate(-5px, 6px);
    background: #e8ecf1;
  }

  .hamburger.active span:nth-child(2) {
    opacity: 0;
    transform: translateX(10px);
  }

  .hamburger.active span:nth-child(3) {
    transform: rotate(45deg) translate(-5px, -6px);
    background: #e8ecf1;
  }

  @media (max-width: 768px) {
    /* Header fijo también en móvil para que siempre sea visible */
    .header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: rgba(8, 10, 15, 0.92);
      backdrop-filter: blur(20px) saturate(1.2);
      -webkit-backdrop-filter: blur(20px) saturate(1.2);
      z-index: 1100;
    }

    /* Compensar el header fijo en el flujo */
    main { padding-top: 64px; }
    
    .hamburger {
      display: flex;
    }
    
    /* Drawer fijo que ocupa alto completo */
    .nav-links {
      position: fixed;
      top: 0;
      right: -80%;
      width: 80%;
      height: 100vh;
      background: rgba(10, 12, 18, 0.98);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      flex-direction: column;
      padding: 2rem 1.5rem;
      gap: 1.5rem;
      transition: right 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      border-left: 1px solid #1e2738;
      z-index: 1200;
      overflow-y: auto;
    }
    
    .nav-links.active {
      right: 0;
    }
    
    .nav-links li {
      border-bottom: 1px solid rgba(30, 39, 56, 0.5);
      padding-bottom: 1rem;
    }
    
    .nav-links a {
      font-size: 1.1rem;
      font-weight: 500;
      color: #c8d1dc;
    }

    .nav-links a::after {
      display: none;
    }

    .logo-img {
      height: 50px;
    }

    .nav {
      justify-content: space-between;
    }
  }

  @media (max-width: 480px) {
    .header {
      padding: 0.8rem 1rem;
    }

    .logo-img {
      height: 42px;
    }

    .nav-links {
      width: 80%;
      padding: 1.5rem;
    }

    .hamburger span {
      width: 20px;
      height: 2px;
    }
  }

  /* Global amenity icon styles for detail pages */
  .amenity-item {
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 255, 255, 0.06) !important;
    border-radius: 14px !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1) !important;
    box-shadow: none !important;
  }

  .amenity-item:hover {
    background: rgba(74, 154, 187, 0.06) !important;
    border-color: rgba(74, 154, 187, 0.15) !important;
    transform: translateY(-4px) !important;
    box-shadow: 0 8px 24px rgba(74, 154, 187, 0.08) !important;
  }

  .amenity-icon-large {
    width: 48px !important;
    height: 48px !important;
    display: block !important;
    margin: 0 auto !important;
    opacity: 0.95 !important;
  }

  /* Colores para los iconos de Lucide */
  [data-icon="/images/iconos-svg/wifi.svg"], [data-lucide="wifi"] { color: #0ea5e9 !important; }
  [data-icon="/images/iconos-svg/parking.svg"], [data-lucide="circle-parking"] { color: #94a3b8 !important; }
  [data-icon="/images/iconos-svg/cocina.svg"], [data-lucide="coffee"] { color: #ea580c !important; }
  [data-icon="/images/iconos-svg/aire-acondicionado.svg"], [data-lucide="snowflake"] { color: #38bdf8 !important; }
</style>

<script>
  // Declarar propiedades custom en window para TypeScript
  declare global {
    interface Window {
      openContactModal: () => void;
      closeContactModal: () => void;
    }
  }

  // Smooth scrolling con compensación + apertura de modal de contacto
  document.querySelectorAll('a[href^="#"], a[href^="/#"]').forEach((anchor) => {
    anchor.addEventListener('click', function (e: Event) {
      const el = anchor as HTMLAnchorElement;
      const href = el.getAttribute('href');
      if (!href) return;

      // Extraer el hash (con o sin /)
      const hash = href.includes('#') ? href.substring(href.indexOf('#')) : null;
      if (!hash) return;

      // Abrir modal de contacto si corresponde (funciona en cualquier página)
      if (hash === '#contacto') {
        e.preventDefault();
        window.openContactModal();
        return;
      }

      // Si el enlace empieza con "/" (ej: /#inicio, /#mapa)
      // Solo hacer scroll si ya estamos en la página principal
      if (href.startsWith('/')) {
        const isHomePage = window.location.pathname === '/' || window.location.pathname === '/index.html';
        if (!isHomePage) {
          // Estamos en otra página, dejar que navegue normalmente
          return;
        }
      }

      // Hacer scroll suave en la página actual
      e.preventDefault();
      const target = document.querySelector(hash);
      if (target) {
        const header = document.querySelector('.header') as HTMLElement | null;
        const headerHeight = header ? header.offsetHeight : 70;
        const elementY = target.getBoundingClientRect().top + window.pageYOffset;
        const offsetY = Math.max(elementY - headerHeight - 20, 0);
        window.scrollTo({ top: offsetY, behavior: 'smooth' });

        // Cerrar menú móvil después del click
        const navLinks = document.getElementById('nav-links');
        const hamburger = document.getElementById('hamburger');
        const overlay = document.getElementById('nav-overlay');
        if (navLinks && hamburger) {
          navLinks.classList.remove('active');
          hamburger.classList.remove('active');
        }
        if (overlay) overlay.classList.remove('active');
        document.body.classList.remove('menu-open');
      }
    });
  });

  // Scroll al cargar página con hash
  window.addEventListener('load', () => {
    const hash = window.location.hash;
    if (hash && hash !== '#contacto') {
      setTimeout(() => {
        const target = document.querySelector(hash);
        if (target) {
          const header = document.querySelector('.header') as HTMLElement | null;
          const headerHeight = header ? header.offsetHeight : 70;
          const elementY = target.getBoundingClientRect().top + window.pageYOffset;
          const offsetY = Math.max(elementY - headerHeight - 20, 0);
          window.scrollTo({ top: offsetY, behavior: 'smooth' });
        }
      }, 100);
    }
  });



  // Mobile hamburger menu + Contact modal
  document.addEventListener('DOMContentLoaded', function() {
    const hamburger = document.getElementById('hamburger');
    const navLinks = document.getElementById('nav-links');
    const overlay = document.getElementById('nav-overlay');

    function openMenu() {
      if (!navLinks || !hamburger) return;
      navLinks.classList.add('active');
      hamburger.classList.add('active');
      if (overlay) overlay.classList.add('active');
      document.body.classList.add('menu-open');
    }

    function closeMenu() {
      if (!navLinks || !hamburger) return;
      navLinks.classList.remove('active');
      hamburger.classList.remove('active');
      if (overlay) overlay.classList.remove('active');
      document.body.classList.remove('menu-open');
    }

    if (hamburger && navLinks) {
      hamburger.addEventListener('click', function() {
        const isOpen = navLinks.classList.contains('active');
        if (isOpen) closeMenu(); else openMenu();
      });

      if (overlay) {
        overlay.addEventListener('click', closeMenu);
      }

      // Cerrar con Escape
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeMenu();
      });
    }

    // Contact modal handlers
    const contactModal = document.getElementById('contact-modal');
    const contactClose = document.getElementById('contact-close');

    window.openContactModal = function() {
      if (!contactModal) return;
      contactModal.hidden = false;
      // No bloqueamos scroll global; el panel vive en la esquina
    };
    window.closeContactModal = function() {
      if (!contactModal) return;
      contactModal.hidden = true;
    };

    if (contactClose) {
      contactClose.addEventListener('click', window.closeContactModal);
    }
    if (contactModal) {
      contactModal.addEventListener('click', function(e){
        if (e.target === contactModal) window.closeContactModal();
      });
    }
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') window.closeContactModal();
    });
  });
</script>