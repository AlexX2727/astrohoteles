---
// src/components/Hero.astro
---

<section class="hero" id="inicio">
  <div class="hero-background">
    <!-- Carrusel de imágenes automático -->
    <div class="image-carousel">
      <div class="carousel-item active">
        <img src="/images/hero/img1.png" alt="Playa de Salinas, Ecuador" />
      </div>
      <div class="carousel-item">
        <img src="/images/hero/img2.png" alt="Hoteles de lujo en Salinas" />
      </div>
      <div class="carousel-item">
        <img src="/images/hero/img3.png" alt="La Chocolatera en Salinas" />
      </div>
      <div class="carousel-item">
        <img src="/images/hero/img4.png" alt="Yacht Club de Salinas" />
      </div>
    </div>

    <div class="hero-overlay"></div>
  </div>

  <div class="hero-content">
    <!-- Título de texto removido - solo logo en navbar -->
  </div>

  <div class="scroll-indicator" onclick="scrollToMap()">
    <svg
      width="56"
      height="56"
      viewBox="0 0 24 24"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M7 10L12 15L17 10"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</section>

<style>
  .hero {
    height: 100vh; /* Fallback */
    height: 100dvh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background-color: #080a0f;
  }

  /* Fondo */
  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 0;
    background-color: #080a0f;
  }

  /* Carrusel de imágenes automático */
  .image-carousel {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
  }

  .carousel-item {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    opacity: 0;
    transition:
      opacity 1.8s cubic-bezier(0.4, 0, 0.2, 1),
      transform 7s ease-out;
    transform: scale(1);
  }

  .carousel-item.active {
    opacity: 1;
    transform: scale(1.08); /* Ken Burns effect - slightly subtler */
  }

  .carousel-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    image-rendering: -webkit-optimize-contrast;
    image-rendering: auto;
  }

  .hero-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    /* Refined gradient with warm, muted tones */
    background: linear-gradient(
      to bottom,
      rgba(8, 10, 15, 0.35) 0%,
      rgba(74, 154, 187, 0.06) 35%,
      rgba(224, 112, 64, 0.04) 55%,
      rgba(8, 10, 15, 0.75) 100%
    );
    z-index: 2;
  }

  /* Contenido principal */
  .hero-content {
    position: relative;
    z-index: 3;
    max-width: 1200px;
    padding: 0 2rem;
    width: 100%;
  }

  /* Título */
  .hero-title {
    font-size: clamp(3rem, 10vw, 7rem);
    font-weight: 900;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
    margin: 0;
    line-height: 1.2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .word-alquileres {
    color: #e8ecf1;
    text-shadow: 0 5px 10px rgba(0, 0, 0, 0.9);
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.8));
  }

  .word-turisticos {
    color: #4a9abb;
    text-shadow: 0 5px 10px rgba(0, 0, 0, 0.9);
    filter: drop-shadow(0 4px 12px rgba(74, 154, 187, 0.5));
  }

  /* Flecha scroll */
  .scroll-indicator {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: #4a9abb;
    animation: bounce 2.5s ease-in-out infinite;
    cursor: pointer;
    z-index: 3;
    transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    background: rgba(255, 255, 255, 0.06);
    padding: 1rem;
    border-radius: 50%;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(74, 154, 187, 0.2);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .scroll-indicator:hover {
    color: #e8ecf1;
    background: rgba(74, 154, 187, 0.25);
    transform: translateX(-50%) scale(1.08);
    box-shadow: 0 8px 30px rgba(74, 154, 187, 0.2);
    border-color: rgba(74, 154, 187, 0.4);
  }

  .scroll-indicator svg {
    width: 3.5rem;
    height: 3.5rem;
    filter: drop-shadow(0 2px 4px rgba(0, 0, 0, 0.2));
  }

  @keyframes bounce {
    0%,
    20%,
    50%,
    80%,
    100% {
      transform: translateX(-50%) translateY(0);
    }
    40% {
      transform: translateX(-50%) translateY(-15px);
    }
    60% {
      transform: translateX(-50%) translateY(-8px);
    }
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .hero {
      min-height: 100vh; /* Fallback */
      min-height: 100dvh;
      height: auto;
    }

    .carousel-item img {
      object-fit: cover;
      object-position: center center;
    }

    .hero-content {
      padding: 0 1.5rem;
    }

    .hero-title {
      font-size: clamp(2.5rem, 8vw, 5rem);
    }

    .scroll-indicator {
      bottom: 1.5rem;
      padding: 0.8rem;
    }

    .scroll-indicator svg {
      width: 3rem;
      height: 3rem;
    }

    .hero-overlay {
      background: linear-gradient(
        to bottom,
        rgba(8, 10, 15, 0.25) 0%,
        rgba(74, 154, 187, 0.05) 30%,
        rgba(224, 112, 64, 0.04) 60%,
        rgba(8, 10, 15, 0.65) 100%
      );
    }
  }

  @media (max-width: 480px) {
    .hero {
      min-height: 100vh; /* Fallback */
      min-height: 100dvh;
    }

    .carousel-item img {
      object-fit: cover;
      object-position: center center;
      min-height: 100vh;
      min-height: 100dvh;
      width: 100%;
    }

    .hero-content {
      padding: 0 1rem;
    }

    .hero-title {
      font-size: clamp(2rem, 7vw, 4rem);
      letter-spacing: 0.05rem;
    }

    .scroll-indicator {
      bottom: 1rem;
      padding: 0.6rem;
    }

    .scroll-indicator svg {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>

<script is:inline>
  function scrollToMap() {
    const mapSection = document.querySelector("#mapa");
    if (mapSection) {
      const header = document.querySelector(".header");
      const headerHeight = header ? header.offsetHeight : 70;
      const elementY =
        mapSection.getBoundingClientRect().top + window.pageYOffset;
      const offsetY = Math.max(elementY - headerHeight, 0);
      window.scrollTo({ top: offsetY, behavior: "smooth" });
    }
  }

  // Carrusel automático
  document.addEventListener("DOMContentLoaded", function () {
    window.scrollToMap = scrollToMap;

    const carouselItems = document.querySelectorAll(".carousel-item");
    let currentIndex = 0;

    function showNextImage() {
      // Remover clase active de la imagen actual
      carouselItems[currentIndex].classList.remove("active");

      // Incrementar el índice
      currentIndex = (currentIndex + 1) % carouselItems.length;

      // Agregar clase active a la nueva imagen
      carouselItems[currentIndex].classList.add("active");
    }

    // Cambiar imagen cada 4 segundos
    setInterval(showNextImage, 4000);
  });
</script>
