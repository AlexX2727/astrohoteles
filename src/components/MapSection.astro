    document.addEventListener("DOMContentLoaded", function () {
      loadAllCategories();
      setupScrollListeners();
    });

    function loadAllCategories() {
      // Cargar departamentos
      if (accommodationsData && accommodationsData["departamentos"]) {
        updateAccommodationList(
          accommodationsData["departamentos"],
          "departamentos-list",
        );
      }

      // Cargar hoteles
      if (accommodationsData && accommodationsData["hoteles"]) {
        updateAccommodationList(accommodationsData["hoteles"], "hoteles-list");
      }
    }

    function setupScrollListeners() {
      const filterTabs = document.querySelectorAll(".filter-tab");

      for (let i = 0; i < filterTabs.length; i++) {
        filterTabs[i].addEventListener("click", function () {
          // Actualizar tabs activas
          for (let j = 0; j < filterTabs.length; j++) {
            filterTabs[j].classList.remove("active");
          }
          this.classList.add("active");

          // Hacer scroll a la sección
          const sectionId = this.getAttribute("data-section");
          const section = document.getElementById(sectionId);
          if (section) {
            section.scrollIntoView({ behavior: "smooth", block: "start" });
          }
        });
      }
    }

    function updateAccommodationList(accommodations, containerId) {
      const listContainer = document.getElementById(containerId);
      if (!listContainer) return;

      if (accommodations.length === 0) {
        listContainer.innerHTML =
          '<div class="loading">No hay alojamientos disponibles</div>';
        return;
      }

      const iconDescriptions = {
        "👥": "Capacidad de huéspedes",
        "📶": "WiFi gratuito",
        "🏊‍♂️": "Piscina",
        "🅿️": "Parqueadero",
        "🌅": "Vista al mar",
        "🍳": "Cocina equipada",
        "☕": "Desayuno incluido",
        "🛁": "Baño incluido",
        "/images/iconos-svg/wifi.svg": "WiFi gratuito",
        "/images/iconos-svg/parking.svg": "Parqueadero",
        "/images/iconos-svg/cocina.svg": "Cocina equipada",
        "/images/iconos-svg/aire-acondicionado.svg": "Aire acondicionado",
      };

      const accommodationCards = accommodations
        .map(function (accommodation, index) {
          const amenityIcons = accommodation.amenities
            .map(function (amenity) {
              const description = iconDescriptions[amenity.icon] || "Amenidad";

              // Si es una ruta SVG, cargar como imagen
              if (
                amenity.icon &&
                amenity.icon.indexOf("/images/iconos-svg/") === 0
              ) {
                return `<div class="amenity-icon" title="${description}">
            <img src="${amenity.icon}" alt="${description}" style="width: 32px; height: 32px; display: block;" />
          </div>`;
              }

              // Si es emoji, usar getAmenityIcon
              return `<div class="amenity-icon" title="${description}">
          ${getAmenityIcon(amenity.icon)}
        </div>`;
            })
            .join("");

          // Determinar la acción del botón de reservar
          const hasDetailPage = accommodation.hasDetailPage || false;
          const reserveAction = hasDetailPage
            ? `onclick="window.location.href='${accommodation.detailPageUrl}'"`
            : `onclick="window.open('https://wa.me/593996779325?text=Hola, estoy interesado en reservar ${accommodation.name}', '_blank')"`;

          // Generar acción para click en imagen
          const imageClickAction = hasDetailPage
            ? `window.location.href='${accommodation.detailPageUrl}'`
            : `window.open('https://wa.me/593996779325?text=Hola, estoy interesado en reservar ${accommodation.name.replace(/'/g, "\\'")}', '_blank')`;

          // Generar imágenes del carrusel
          const images = accommodation.images || [accommodation.image];
          const carouselImages = images
            .map(function (img, imgIndex) {
              return `<img
          src="${img}"
          alt="${accommodation.name}"
          class="card-image ${imgIndex === 0 ? "active" : ""}"
          onclick="${imageClickAction}"
        >`;
            })
            .join("");

          return `
        <div class="accommodation-card" data-card-id="${index}">
          <div class="card-image-container">
            ${carouselImages}
          </div>
          <div class="card-content card-content-center">
            <div class="card-header-center">
              <h3 class="card-title-center">${accommodation.name}</h3>
            </div>
            <div class="card-amenities-icons-center">
              ${amenityIcons}
            </div>
            <div class="card-footer-center">
              <button
                class="reserve-btn-orange"
                ${reserveAction}
              >RESERVAR</button>
            </div>
          </div>
        </div>
      `;
        })
        .join("");

      listContainer.innerHTML = accommodationCards;

      // Iniciar carruseles de imágenes
      startImageCarousels();
    }

    function startImageCarousels() {
      const cards = document.querySelectorAll(".accommodation-card");

      cards.forEach(function (card) {
        const images = card.querySelectorAll(".card-image");
        if (images.length <= 1) return; // Si solo hay una imagen, no hacer carrusel

        let currentIndex = 0;

        setInterval(function () {
          images[currentIndex].classList.remove("active");
          currentIndex = (currentIndex + 1) % images.length;
          images[currentIndex].classList.add("active");
        }, 3000); // Cambiar cada 3 segundos
      });
    }

    function openMiniMap(lng, lat, name) {
      try {
        const overlay = document.getElementById("mini-map-overlay");
        const iframe = document.getElementById("mini-map-iframe");
        const directions = document.getElementById("mini-map-directions");
        if (!overlay || !iframe || !directions) return;

        const src = `https://www.google.com/maps?q=${lat},${lng}&z=15&output=embed`;
        iframe.src = src;
        directions.href = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}&travelmode=driving`;
        overlay.hidden = false;
        document.body.classList.add("menu-open");
      } catch (e) {
        console.error("Error al abrir mapa:", e);
      }
    }

    function closeMiniMap() {
      const overlay = document.getElementById("mini-map-overlay");
      const iframe = document.getElementById("mini-map-iframe");
      if (overlay) overlay.hidden = true;
      if (iframe) iframe.src = "";
      document.body.classList.remove("menu-open");
    }

    document.addEventListener("click", function (e) {
      const overlay = document.getElementById("mini-map-overlay");
      if (!overlay || overlay.hidden) return;
      const dialog = overlay.querySelector(".mini-map-dialog");
      const closeBtn = document.getElementById("mini-map-close");
      if (e.target === overlay || e.target === closeBtn) {
        closeMiniMap();
      }
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape") closeMiniMap();
    });

    window.openMiniMap = openMiniMap;
    window.closeMiniMap = closeMiniMap;
  })();
</script>
