---
// src/components/MapSection.astro
import {
  accommodationsData,
  getAmenityIcon,
  MAPBOX_CONFIG,
} from "../data/accommodationData.js";
---

<section class="map-section" id="mapa">
  <div class="main-container">
    <!-- Sidebar ahora ocupa todo el ancho -->
    <div class="sidebar">
      <!-- Filter Tabs -->
      <div class="filter-tabs">
        <button class="filter-tab active" data-section="departamentos-section">
          <svg class="filter-tab-icon" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="3" width="20" height="18" rx="1" fill="currentColor"
            ></rect>
            <rect
              x="4"
              y="6"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <rect
              x="14"
              y="6"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <rect
              x="4"
              y="12"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <rect
              x="14"
              y="12"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <circle cx="12" cy="18" r="0.8" fill="#000" opacity="0.4"></circle>
            <rect x="11" y="16.5" width="2" height="1" fill="#000" opacity="0.4"
            ></rect>
          </svg>
          Departamentos, Villas y Suite
        </button>
        <button class="filter-tab" data-section="hoteles-section">
          <svg class="filter-tab-icon" viewBox="0 0 24 24" fill="none">
            <path
              d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H9.5v-7h-8L2 19h20L20.5 7z"
              fill="currentColor"></path>
            <rect x="6" y="9" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
            <rect x="15" y="9" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
            <rect x="6" y="12" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
            <rect x="15" y="12" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
          </svg>
          Hoteles & Hostales
        </button>
      </div>

      <!-- Sección Departamentos, Villas y Suite -->
      <div class="category-section" id="departamentos-section">
        <div class="category-header">
          <svg class="category-icon" viewBox="0 0 24 24" fill="none">
            <rect x="2" y="3" width="20" height="18" rx="1" fill="currentColor"
            ></rect>
            <rect
              x="4"
              y="6"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <rect
              x="14"
              y="6"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <rect
              x="4"
              y="12"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <rect
              x="14"
              y="12"
              width="6"
              height="4"
              rx="0.5"
              fill="#000"
              opacity="0.2"></rect>
            <circle cx="12" cy="18" r="0.8" fill="#000" opacity="0.4"></circle>
            <rect x="11" y="16.5" width="2" height="1" fill="#000" opacity="0.4"
            ></rect>
          </svg>
          <h2 class="category-title">Departamentos, Villas y Suite</h2>
        </div>
        <div class="accommodation-list" id="departamentos-list">
          <div class="loading">
            <div class="spinner"></div>
          </div>
        </div>
      </div>

      <!-- Sección Hoteles & Hostales -->
      <div class="category-section" id="hoteles-section">
        <div class="category-header">
          <svg class="category-icon" viewBox="0 0 24 24" fill="none">
            <path
              d="M7 13c1.66 0 3-1.34 3-3S8.66 7 7 7s-3 1.34-3 3 1.34 3 3 3zm12-6h-8v7H9.5v-7h-8L2 19h20L20.5 7z"
              fill="currentColor"></path>
            <rect x="6" y="9" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
            <rect x="15" y="9" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
            <rect x="6" y="12" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
            <rect x="15" y="12" width="2" height="2" fill="#000" opacity="0.3"
            ></rect>
          </svg>
          <h2 class="category-title">Hoteles & Hostales</h2>
        </div>
        <div class="accommodation-list" id="hoteles-list">
          <div class="loading">
            <div class="spinner"></div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mini Map Overlay para cuando hacen clic en una imagen -->
  <div id="mini-map-overlay" class="mini-map-overlay" hidden>
    <div class="mini-map-dialog">
      <button class="mini-map-close" id="mini-map-close" aria-label="Cerrar"
        >×</button
      >
      <iframe
        id="mini-map-iframe"
        class="mini-map-iframe"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
      <div class="mini-map-actions">
        <a
          id="mini-map-directions"
          target="_blank"
          rel="noopener"
          class="reserve-btn-orange"
          href="#">Cómo llegar</a
        >
      </div>
    </div>
  </div>
</section>

<style is:global>
  .map-section {
    min-height: 100vh;
    background: #050505; /* Slightly lighter black for depth */
  }

  .main-container {
    display: flex;
    height: 100vh;
  }

  /* Sidebar ahora ocupa todo el ancho */
  .sidebar {
    width: 100%;
    background: #0a0a0a;
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: #333 #0a0a0a;
  }

  @media (min-width: 1200px) {
    .main-container {
      max-width: 1600px; /* Wider container for better grid */
      margin: 0 auto;
      padding: 0 2rem;
    }

    .sidebar {
      border-radius: 24px;
      border: 1px solid #222;
      margin-top: 2rem;
      margin-bottom: 2rem;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.5);
    }
  }

  /* Filter Tabs */
  .filter-tabs {
    display: flex;
    background: rgba(26, 26, 26, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #222;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .filter-tab {
    flex: 1;
    padding: 1.2rem;
    text-align: center;
    background: none;
    border: none;
    color: #888;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 0.95rem;
    font-weight: 500;
    position: relative;
    letter-spacing: 0.5px;
  }

  .filter-tab:hover {
    color: #ccc;
    background: rgba(255, 255, 255, 0.02);
  }

  .filter-tab.active {
    color: #fff;
    background: rgba(57, 185, 252, 0.05);
  }

  .filter-tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: #39b9fc;
    transform: scaleX(0);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 -2px 10px rgba(57, 185, 252, 0.5);
  }

  .filter-tab.active::after {
    transform: scaleX(1);
  }

  .filter-tab-icon {
    width: 1.6rem;
    height: 1.6rem;
    margin-bottom: 0.4rem;
    display: block;
    margin-left: auto;
    margin-right: auto;
    transition: transform 0.3s ease;
  }

  .filter-tab:hover .filter-tab-icon {
    transform: translateY(-2px);
  }

  /* Category Sections */
  .category-section {
    margin-bottom: 4rem;
  }

  .category-header {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 2.5rem 2.5rem 1.5rem 2.5rem;
    background: linear-gradient(
      180deg,
      rgba(57, 185, 252, 0.08) 0%,
      rgba(0, 0, 0, 0) 100%
    );
    border-bottom: 1px solid rgba(57, 185, 252, 0.2);
  }

  .category-icon {
    width: 2.8rem;
    height: 2.8rem;
    color: #39b9fc;
    flex-shrink: 0;
    filter: drop-shadow(0 0 10px rgba(57, 185, 252, 0.4));
  }

  .category-title {
    font-size: 2rem;
    font-weight: 800;
    color: #fff;
    margin: 0;
    letter-spacing: -0.5px;
  }

  @media (max-width: 768px) {
    .category-header {
      padding: 1.5rem 1.5rem 1rem 1.5rem;
    }

    .category-icon {
      width: 2.2rem;
      height: 2.2rem;
    }

    .category-title {
      font-size: 1.5rem;
    }
  }

  /* Accommodation Cards - Grid responsivo */
  .accommodation-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 2.5rem;
    padding: 2.5rem;
  }

  @media (max-width: 768px) {
    .accommodation-list {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding: 1.5rem;
    }
  }

  .accommodation-card {
    background: #141414;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid #2a2a2a;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    cursor: pointer;
    position: relative;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .accommodation-card:hover {
    border-color: #39b9fc;
    transform: translateY(-8px);
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(57, 185, 252, 0.3);
  }

  .card-image-container {
    position: relative;
    width: 100%;
    height: 240px;
    overflow: hidden;
    background-color: #222;
  }

  .card-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    z-index: 1;
    transition:
      opacity 1s ease,
      transform 0.6s ease;
  }

  .card-image.active {
    opacity: 1;
    z-index: 10;
  }

  .accommodation-card:hover .card-image {
    transform: scale(1.05);
  }

  /* ESTILOS CENTRADOS PARA CARDS */
  .accommodation-card .card-content-center {
    padding: 1.5rem !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: space-between !important;
    text-align: center !important;
    min-height: 200px !important;
    width: 100% !important;
    position: relative !important;
    z-index: 2 !important;
    background: linear-gradient(
      180deg,
      rgba(20, 20, 20, 0) 0%,
      rgba(20, 20, 20, 1) 100%
    );
  }

  .accommodation-card .card-title-center {
    font-size: 1.1rem !important;
    font-weight: 700 !important;
    color: #fff !important;
    margin: 0 0 1rem 0 !important;
    text-align: center !important;
    line-height: 1.4 !important;
    letter-spacing: 0.3px !important;
  }

  .accommodation-card .card-amenities-icons-center {
    display: flex !important;
    gap: 0.8rem !important;
    justify-content: center !important;
    align-items: center !important;
    margin: 0.5rem 0 1.5rem 0 !important;
    flex-wrap: wrap !important;
    width: 100% !important;
  }

  /* BOTÓN NARANJA */
  .accommodation-card .card-footer-center .reserve-btn-orange,
  .accommodation-card button.reserve-btn-orange,
  button.reserve-btn-orange {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 100% !important;
    max-width: 200px !important;
    background: #ff6b35 !important;
    color: white !important;
    border: none !important;
    padding: 12px 24px !important;
    border-radius: 12px !important;
    font-weight: 600 !important;
    font-size: 0.9rem !important;
    cursor: pointer !important;
    text-transform: uppercase !important;
    letter-spacing: 1px !important;
    transition: all 0.3s ease !important;
    box-shadow: 0 4px 15px rgba(255, 107, 53, 0.3) !important;
  }

  .accommodation-card .reserve-btn-orange:hover,
  button.reserve-btn-orange:hover {
    background: #ff5514 !important;
    transform: translateY(-2px) !important;
    box-shadow: 0 8px 25px rgba(255, 107, 53, 0.5) !important;
  }

  /* ICONOS */
  .accommodation-card .card-amenities-icons-center .amenity-icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 8px !important;
    border-radius: 10px !important;
    background: rgba(255, 255, 255, 0.05) !important;
    transition: all 0.3s ease !important;
    border: 1px solid rgba(255, 255, 255, 0.05) !important;
  }

  .accommodation-card .card-amenities-icons-center .amenity-icon:hover {
    background: rgba(255, 255, 255, 0.1) !important;
    transform: translateY(-2px) !important;
    border-color: rgba(255, 255, 255, 0.2) !important;
  }

  .accommodation-card .card-amenities-icons-center .amenity-icon svg {
    width: 20px !important;
    height: 20px !important;
    opacity: 0.9 !important;
  }

  /* Loading Animation */
  .loading {
    display: flex;
    justify-content: center;
    align-items: center;
    height: 300px;
    width: 100%;
    grid-column: 1 / -1;
  }

  .spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(57, 185, 252, 0.1);
    border-top: 3px solid #39b9fc;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  /* Mini map overlay */
  .mini-map-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(5px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1500;
  }
  .mini-map-overlay[hidden] {
    display: none !important;
  }

  .mini-map-dialog {
    position: relative;
    width: min(90vw, 800px);
    background: #111;
    border: 1px solid #333;
    border-radius: 24px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    overflow: hidden;
    animation: dialogFadeIn 0.3s ease-out;
  }

  @keyframes dialogFadeIn {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .mini-map-close {
    position: absolute;
    margin: 12px;
    right: 0;
    top: 0;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(0, 0, 0, 0.8);
    color: #fff;
    cursor: pointer;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    transition: all 0.2s ease;
  }

  .mini-map-close:hover {
    background: #fff;
    color: #000;
  }

  .mini-map-iframe {
    width: 100%;
    height: 500px;
    border: 0;
    display: block;
  }

  .mini-map-actions {
    display: flex;
    justify-content: center;
    padding: 20px;
    background: #111;
    border-top: 1px solid #222;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .main-container {
      flex-direction: column;
      height: auto;
    }

    .sidebar {
      height: auto;
      width: 100%;
      border: none;
      border-radius: 0;
      margin: 0;
    }

    .category-section {
      margin-bottom: 3rem;
    }

    .accommodation-list {
      padding: 1rem;
      gap: 1.5rem;
    }

    .card-image-container {
      height: 200px;
    }

    .mini-map-dialog {
      width: 100vw;
      height: 100vh;
      border-radius: 0;
      border: none;
    }

    .mini-map-iframe {
      height: calc(100vh - 80px);
    }
  }
</style>

<script is:inline define:vars={{ accommodationsData, MAPBOX_CONFIG }}>
  // @ts-nocheck
  (function () {
    // getAmenityIcon function (client-side)
    function getAmenityIcon(iconType) {
      const iconMap = {
        "👥": `<svg viewBox="0 0 32 32" fill="none" width="32" height="32">
        <defs>
