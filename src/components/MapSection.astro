          </filter>
        </defs>
        <ellipse cx="16" cy="28" rx="12" ry="2" fill="url(#wifiRadialC)" opacity="0.4"/>
        <g filter="url(#wifiGlowC)">
          <path d="M4 14c6-6 18-6 24 0" stroke="url(#wifiGradC)" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.4"/>
          <path d="M8 18c4-4 12-4 16 0" stroke="url(#wifiGradC)" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="0.7"/>
          <path d="M12 22c2-2 6-2 8 0" stroke="url(#wifiGradC)" stroke-width="3.5" stroke-linecap="round" fill="none" opacity="1"/>
