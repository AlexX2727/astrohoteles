        <path d="M16 26v-4c0-3.5 3-6 6-6s6 2.5 6 6v4" stroke="url(#peopleGradC)" stroke-width="3" stroke-linecap="round" fill="none" filter="url(#peopleShadowC)"/>
      </svg>`,
